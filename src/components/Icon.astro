---
interface Props {
  name: 'phone' | 'arrow' | 'mail' | 'pin' | 'menu' | 'close';
  class?: string;
}
const { name, class: cls } = Astro.props;
const paths: Record<Props['name'], string> = {
  phone:
    'M5 3.5h3.2l1.6 4-2 1.3a11 11 0 0 0 7.4 7.4l1.3-2 4 1.6V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.1 1.5 1.5 0 0 1 5 3.5z',
  arrow: 'M4 12h15M13 6l6 6-6 6',
  mail: 'M3.5 6.5h17v11h-17zM4 7l8 6 8-6',
  pin: 'M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0 1 13 0c0 4.8-6.5 11-6.5 11zM12 12.3a2.3 2.3 0 1 0 0-4.6 2.3 2.3 0 0 0 0 4.6z',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6L6 18',
};
---

<svg
  class:list={["icon", cls]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"><path d={paths[name]}></path></svg>
