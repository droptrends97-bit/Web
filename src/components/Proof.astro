---
import { testimonials } from '../data/site';
const [lead] = testimonials;
const logos = [
  { src: '/img/alci.png', alt: 'ALCI member: Association of Landscape Contractors of Ireland', w: 432, h: 313 },
  { src: '/img/guild.png', alt: 'Member of the National Guild of Master Craftsmen', w: 324, h: 334 },
  { src: '/img/houzz.png', alt: 'Find us on Houzz', w: 356, h: 259 },
  { src: '/img/pickapro.png', alt: 'Find us on pickapro.ie', w: 226, h: 162 },
];
---

<section class="proof" aria-labelledby="proof-title">
  <div class="wrap">
    <h2 id="proof-title" class="visually-hidden">Reviews and memberships</h2>
    <figure class="quote" data-reveal>
      <blockquote>
        <p>{lead.quote}</p>
      </blockquote>
      <figcaption>
        <span class="avatar" aria-hidden="true" data-pop style="--d:3">{lead.name.split(' ').map((n) => n[0]).join('')}</span>
        <span>{lead.name}<br /><span class="role">Client</span></span>
      </figcaption>
    </figure>
  </div>

  <p class="logos-label">Accredited and listed with</p>
  <div class="marquee logos" style="--speed: 30s; --gap: 1rem">
    {
      [0, 1, 2].map((k) => (
        <ul class="marquee-track" aria-hidden={k > 0 ? 'true' : undefined}>
          {logos.map((l) => (
            <li>
              <img src={l.src} alt={k === 0 ? l.alt : ''} width={l.w} height={l.h} loading="lazy" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>

<style>
  .proof {
    padding-block: clamp(4rem, 9vw, 7rem);
    background: var(--paper-2);
    border-radius: var(--radius-lg);
    margin-inline: clamp(0.5rem, 1.5vw, 1rem);
    overflow: hidden;
  }
  .quote {
    margin: 0 auto;
    max-width: 52rem;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 1.75rem;
  }
  blockquote {
    margin: 0;
  }
  blockquote p {
    font-family: var(--display);
    font-stretch: 82%;
    font-weight: 600;
    font-size: clamp(2rem, 4.4vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-align: left;
    font-weight: 650;
    line-height: 1.3;
  }
  .role {
    font-weight: 400;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--evergreen);
    color: var(--leaf);
    font-weight: 700;
  }

  .logos-label {
    text-align: center;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink-2);
    margin-top: clamp(3rem, 6vw, 4.5rem);
    margin-bottom: 1.25rem;
  }
  .logos .marquee-track {
    list-style: none;
    margin: 0;
  }
  .logos li {
    background: #fff;
    border-radius: 18px;
    height: 6.5rem;
    width: 12rem;
    padding: 0.9rem 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }
  .logos img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
  }
</style>
