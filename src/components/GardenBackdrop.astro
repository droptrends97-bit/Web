---
// A decorative garden that grows along the screen edges as the visitor scrolls:
// trees near the top, then clipped box balls, then potted flowers. Purely decorative.
// Each photo was cut out of its white background; leaves are drawn so they stay crisp.

type Kind = 'tree' | 'bush' | 'pot';
type Plant = {
  stage: 0 | 1 | 2;
  side: 'left' | 'right';
  x: string;
  h: string;
  src: string;
  kind: Kind;
  flip?: boolean;
  far?: boolean;
  z?: number;
};

const img = (n: string) => `/img/garden/${n}.webp`;

const plants: Plant[] = [
  // Trees, with a box ball at the foot of one and a smaller tree further back.
  { stage: 0, side: 'left', x: '-14vw', h: '72vh', src: img('tree'), kind: 'tree' },
  { stage: 0, side: 'left', x: '3vw', h: '11vh', src: img('bush-1'), kind: 'bush', z: 2 },
  { stage: 0, side: 'right', x: '-12vw', h: '62vh', src: img('tree'), kind: 'tree', flip: true },
  { stage: 0, side: 'right', x: '7vw', h: '36vh', src: img('tree'), kind: 'tree', far: true, z: 0 },
  // Box balls in loose groups, with a tree in the distance.
  { stage: 1, side: 'left', x: '-7vw', h: '19vh', src: img('bush-pair'), kind: 'bush', z: 2 },
  { stage: 1, side: 'left', x: '9vw', h: '10vh', src: img('bush-0'), kind: 'bush', z: 3 },
  { stage: 1, side: 'right', x: '1vw', h: '46vh', src: img('tree'), kind: 'tree', far: true, flip: true, z: 0 },
  { stage: 1, side: 'right', x: '-4vw', h: '21vh', src: img('bush-2'), kind: 'bush', z: 2 },
  { stage: 1, side: 'right', x: '10vw', h: '12vh', src: img('bush-1'), kind: 'bush', flip: true, z: 3 },
  // Potted flowers, with a box ball tucked behind.
  { stage: 2, side: 'left', x: '-10vw', h: '23vh', src: img('pots-group'), kind: 'pot', z: 1 },
  { stage: 2, side: 'left', x: '9vw', h: '17vh', src: img('pot-purple'), kind: 'pot', z: 3 },
  { stage: 2, side: 'right', x: '7vw', h: '11vh', src: img('bush-0'), kind: 'bush', flip: true, z: 1 },
  { stage: 2, side: 'right', x: '-1vw', h: '27vh', src: img('pot-red'), kind: 'pot', z: 2 },
];

// Leaves that drift off each tree once it has rustled. They start from the strip
// of crown that shows at the screen edge (most of each tree sits off-screen), and a
// calm breeze carries them down with a little sideways drift.
const leafColours = ['#4f7d2c', '#d4a72c', '#86ad45', '#5c8c33', '#c8792f', '#6a9a3a', '#a3b84d'];
const leavesFor = (p: Plant, i: number) =>
  Array.from({ length: p.far ? 4 : 7 }, (_, k) => {
    const r = (n: number) => (Math.sin((i + 1) * 97.13 + k * 31.7 + n * 13.1) + 1) / 2;
    const fromEdge = `calc(${p.x} * -1 + ${(1 + r(1) * 8).toFixed(1)}vw)`;
    return {
      colour: leafColours[(i + k) % leafColours.length],
      style: [
        `${p.side}:${fromEdge}`,
        `top:${(10 + r(2) * 38).toFixed(1)}%`,
        `--wx:${Math.round((r(3) - 0.35) * 90) * (p.side === 'left' ? 1 : -1)}px`,
        `--fall:${Math.round(30 + r(4) * 25)}vh`,
        `--dur:${(7 + r(5) * 4).toFixed(1)}s`,
        `--ld:${(k * 1.15 + r(6) * 0.6).toFixed(2)}s`,
        `--sz:${Math.round(p.far ? 9 + r(7) * 3 : 12 + r(7) * 6)}px`,
        `--spin:${Math.round(180 + r(8) * 260) * (k % 2 ? 1 : -1)}deg`,
      ].join(';'),
    };
  });
---

<div class="garden" aria-hidden="true" data-stage="0">
  {
    plants.map((p, i) => (
      <div
        class:list={['plant', p.kind, { far: p.far }]}
        data-stage={p.stage}
        style={`${p.side}: ${p.x}; --h: ${p.h}; --d: ${i % 4}; --sway: ${(i % 3) + 5}s; --tilt: ${i % 2 ? -1 : 1}; z-index: ${p.z ?? 1};`}
      >
        <div class="sway">
          <img class:list={['rustle', { flip: p.flip }]} src={p.src} alt="" decoding="async" />
        </div>
        {p.kind === 'tree' &&
          leavesFor(p, i).map((l) => (
            <span class="leaf" style={l.style}>
              <svg viewBox="0 0 20 32">
                <path d="M10 1C3 9 2 20 10 31 18 20 17 9 10 1z" fill={l.colour} />
                <path d="M10 5v24" stroke="rgb(0 0 0 / 0.2)" stroke-width="1" fill="none" />
              </svg>
            </span>
          ))}
      </div>
    ))
  }
</div>

<script>
  const garden = document.querySelector<HTMLElement>('.garden');
  if (garden) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const max = document.documentElement.scrollHeight - innerHeight;
      const p = max > 0 ? scrollY / max : 0;
      const stage = p < 0.3 ? 0 : p < 0.64 ? 1 : 2;
      if (garden.dataset.stage !== String(stage)) garden.dataset.stage = String(stage);
    };
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    addEventListener('resize', update);
    update();
    // Let the first trees grow in after the page settles.
    requestAnimationFrame(() => setTimeout(() => garden.classList.add('ready'), 400));
  }
</script>

<style>
  .garden {
    position: fixed;
    inset: auto 0 0 0;
    height: 100svh;
    z-index: -1;
    pointer-events: none;
    overflow: clip;
    /* Full at the screen edges, faded before the content column. */
    --edge: linear-gradient(90deg, #000 0, #000 3vw, transparent 11vw, transparent calc(100% - 11vw), #000 calc(100% - 3vw), #000 100%);
    -webkit-mask-image: var(--edge);
    mask-image: var(--edge);
  }
  .plant {
    --o: 0.95;
    position: absolute;
    height: calc(var(--h) * var(--scale, 1));
    bottom: -2px;
    opacity: 0;
    transform: translateY(40%) scale(0.2);
    transform-origin: 50% 100%;
    transition:
      transform 420ms cubic-bezier(0.5, 0, 0.75, 0),
      opacity 300ms;
  }
  .plant.far {
    --o: 0.5;
    filter: saturate(0.7);
  }
  .sway {
    height: 100%;
    transform-origin: 50% 100%;
    animation: sway var(--sway) ease-in-out infinite alternate;
  }
  .plant img {
    display: block;
    height: 100%;
    width: auto;
    max-width: none;
    transform-origin: 50% 100%;
  }
  .plant img.flip {
    scale: -1 1;
  }
  .ready[data-stage='0'] .plant[data-stage='0'],
  .ready[data-stage='1'] .plant[data-stage='1'],
  .ready[data-stage='2'] .plant[data-stage='2'] {
    opacity: var(--o);
    transform: none;
    transition:
      transform 1100ms cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 400ms;
    transition-delay: calc(350ms + var(--d) * 140ms);
  }
  @keyframes sway {
    from {
      transform: rotate(calc(var(--tilt) * -0.8deg));
    }
    to {
      transform: rotate(calc(var(--tilt) * 0.8deg));
    }
  }

  /* Once a plant has grown in, it rustles: trees bustle hard and settle,
     bushes give a quick shiver, pots a little settle. Then leaves drift off the trees. */
  .plant {
    --grown: calc(350ms + var(--d) * 140ms + 900ms);
  }
  :is(.ready[data-stage='0'] .plant[data-stage='0'], .ready[data-stage='1'] .plant[data-stage='1'], .ready[data-stage='2'] .plant[data-stage='2']) .rustle,
  :global(html:not(.js)) .rustle {
    animation: var(--rustle, rustle-tree) var(--rustle-dur, 1.8s) cubic-bezier(0.3, 0.6, 0.4, 1) var(--grown) both;
  }
  .bush {
    --rustle: rustle-bush;
    --rustle-dur: 1s;
  }
  .pot {
    --rustle: rustle-pot;
    --rustle-dur: 1.1s;
  }
  @keyframes rustle-tree {
    0% { rotate: 0deg; translate: 0 0; filter: brightness(1); }
    8% { rotate: -2.6deg; translate: -3px 0; filter: brightness(1.06); }
    17% { rotate: 2.4deg; translate: 3px 0; }
    26% { rotate: -2deg; translate: -2px 0; filter: brightness(1.04); }
    36% { rotate: 1.6deg; translate: 2px 0; }
    47% { rotate: -1.1deg; translate: -1px 0; filter: brightness(1.02); }
    60% { rotate: 0.7deg; translate: 1px 0; }
    75% { rotate: -0.35deg; }
    100% { rotate: 0deg; translate: 0 0; filter: brightness(1); }
  }
  @keyframes rustle-bush {
    0% { rotate: 0deg; scale: 1; }
    15% { rotate: -1.4deg; scale: 1.03 0.97; }
    32% { rotate: 1.2deg; scale: 0.98 1.02; }
    50% { rotate: -0.8deg; scale: 1.01 0.99; }
    70% { rotate: 0.4deg; }
    100% { rotate: 0deg; scale: 1; }
  }
  @keyframes rustle-pot {
    0% { rotate: 0deg; }
    25% { rotate: -1.6deg; }
    50% { rotate: 1deg; }
    75% { rotate: -0.4deg; }
    100% { rotate: 0deg; }
  }

  .leaf {
    position: absolute;
    width: var(--sz);
    height: calc(var(--sz) * 1.6);
    opacity: 0;
  }
  .leaf svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  :is(.ready[data-stage='0'] .plant[data-stage='0'], .ready[data-stage='1'] .plant[data-stage='1']) .leaf,
  :global(html:not(.js)) .leaf {
    animation: leaf-fall var(--dur) cubic-bezier(0.45, 0.1, 0.6, 0.95) calc(var(--grown) + 1.5s + var(--ld)) infinite;
  }
  :is(.ready[data-stage='0'] .plant[data-stage='0'], .ready[data-stage='1'] .plant[data-stage='1']) .leaf svg,
  :global(html:not(.js)) .leaf svg {
    animation: leaf-flutter 1.9s ease-in-out infinite alternate;
  }
  /* Leaves drift down and out on a calm breeze, fading away near the ground. */
  @keyframes leaf-fall {
    0% { opacity: 0; translate: 0 0; rotate: 0deg; }
    8% { opacity: 1; }
    35% { translate: calc(var(--wx) * 0.45) calc(var(--fall) * 0.3); }
    70% { opacity: 0.9; translate: calc(var(--wx) * 0.8) calc(var(--fall) * 0.7); }
    100% { opacity: 0; translate: var(--wx) var(--fall); rotate: var(--spin); }
  }
  @keyframes leaf-flutter {
    from { rotate: -35deg; translate: -10px 0; }
    to { rotate: 35deg; translate: 10px 0; }
  }

  /* Without JavaScript (e.g. iPad file previews): show the trees, and where the
     browser supports scroll-driven animation, swap stages by scroll position. */
  :global(html:not(.js)) .plant[data-stage='0'] {
    opacity: var(--o);
    transform: none;
  }
  @supports (animation-timeline: scroll()) {
    :global(html:not(.js)) .plant {
      animation-timeline: scroll(root);
      animation-fill-mode: both;
      animation-timing-function: linear;
      animation-duration: auto;
    }
    :global(html:not(.js)) .plant[data-stage='0'] {
      animation-name: stage-0;
    }
    :global(html:not(.js)) .plant[data-stage='1'] {
      animation-name: stage-1;
    }
    :global(html:not(.js)) .plant[data-stage='2'] {
      animation-name: stage-2;
    }
  }
  @keyframes stage-0 {
    0%, 26% { opacity: var(--o); transform: none; }
    32%, 100% { opacity: 0; transform: translateY(40%) scale(0.2); }
  }
  @keyframes stage-1 {
    0%, 26% { opacity: 0; transform: translateY(40%) scale(0.2); }
    34%, 58% { opacity: var(--o); transform: none; }
    66%, 100% { opacity: 0; transform: translateY(40%) scale(0.2); }
  }
  @keyframes stage-2 {
    0%, 60% { opacity: 0; transform: translateY(40%) scale(0.2); }
    68%, 100% { opacity: var(--o); transform: none; }
  }

  @media (max-width: 760px) {
    .garden {
      --scale: 0.5;
      opacity: 0.7;
      --edge: linear-gradient(90deg, #000 0, transparent 22vw, transparent 78vw, #000 100%);
    }
  }
  @media (min-width: 1600px) {
    .garden {
      --edge: linear-gradient(90deg, #000 0, #000 9vw, transparent 17vw, transparent calc(100% - 17vw), #000 calc(100% - 9vw), #000 100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .plant,
    .ready .plant {
      transition: opacity 1ms !important;
    }
    .sway,
    .rustle,
    .leaf,
    .leaf svg {
      animation: none !important;
    }
  }
</style>
