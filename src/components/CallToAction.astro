---
import Split from './Split.astro';
import Icon from './Icon.astro';
import { contact } from '../data/site';

interface Props {
  heading?: string;
  text?: string;
}
const { heading = 'Tell us about your garden.', text } = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <div class="cta-card" data-reveal>
    <div class="cta-copy">
      <h2 id="cta-title" class="rise rise-blur" aria-label={heading}><Split text={heading} /></h2>
      <p>{text ?? `Call Darragh for a chat, or send a few details and we'll arrange a visit. We work across ${contact.area}.`}</p>
    </div>
    <div class="cta-actions">
      <a class="cta-phone" href={contact.phoneHref} data-pop style="--d:2">
        <span class="cta-phone-icon"><Icon name="phone" /></span>
        <span>{contact.phone}</span>
      </a>
      <div class="cta-row">
        <a class="btn btn-leaf" href="/contact/">Request a quote <Icon name="arrow" /></a>
        <a class="cta-mail" href={`mailto:${contact.email}`}>{contact.email}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding: clamp(3rem, 7vw, 5rem) clamp(0.5rem, 1.5vw, 1rem);
  }
  .cta-card {
    max-width: calc(var(--max) + 4rem);
    margin-inline: auto;
    position: relative;
    isolation: isolate;
    overflow: clip;
    border-radius: var(--radius-lg);
    --on-season: #f4f6ee;
    --on-season-2: #d5dccd;
    --season: var(--evergreen);
    background:
      linear-gradient(100deg, rgb(13 30 20 / 0.92) 0%, rgb(13 30 20 / 0.78) 45%, rgb(13 30 20 / 0.35) 100%),
      url('/img/garden-bench-panorama.jpg') center / cover;
    color: var(--on-season);
    padding: clamp(2rem, 6vw, 5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem clamp(2rem, 5vw, 5rem);
    align-items: end;
  }
  .cta-card::before {
    content: '';
    position: absolute;
    width: 60%;
    aspect-ratio: 1;
    right: -15%;
    top: -40%;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 30%, transparent), transparent);
    z-index: -1;
    animation: drift 14s ease-in-out infinite alternate;
  }
  @keyframes drift {
    to {
      transform: translate(-30%, 40%);
    }
  }
  .cta h2 {
    max-width: 10ch;
    font-size: clamp(2.6rem, 6vw, 5rem);
  }
  .cta-copy {
    display: grid;
    gap: 1.25rem;
  }
  .cta-copy p {
    color: var(--on-season-2);
    max-width: 44ch;
  }
  .cta-actions {
    display: grid;
    gap: 1.5rem;
  }
  .cta-phone {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(2.4rem, 6vw, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    white-space: nowrap;
  }
  .cta-phone-icon {
    flex: none;
    width: 0.95em;
    height: 0.95em;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--accent);
    color: var(--on-accent);
    transition: transform 400ms var(--ease-out);
  }
  .cta-phone-icon :global(svg) {
    width: 45%;
    height: 45%;
  }
  .cta-card.in .cta-phone-icon {
    animation: ring-in 3.5s ease-in-out 1.2s infinite;
  }
  @keyframes ring-in {
    0%, 80%, 100% { rotate: 0deg; }
    83% { rotate: -16deg; }
    86% { rotate: 14deg; }
    89% { rotate: -10deg; }
    92% { rotate: 6deg; }
  }
  .cta-phone:hover .cta-phone-icon {
    transform: rotate(-12deg) scale(1.06);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  .cta-mail {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  @media (max-width: 860px) {
    .cta-card {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-card::before {
      animation: none;
    }
  }
</style>
