---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import GardenBackdrop from '../components/GardenBackdrop.astro';
import { contact, nav, services, months, serviceMenu } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  callbar?: boolean;
  garden?: boolean;
}

const {
  title,
  callbar = true,
  garden = false,
  description = 'Garden care and maintenance across Dublin and North Wicklow. Regular visits, seasonal Garden Interventions, lawn and soil health, and designed pots and planters.',
} = Astro.props;

const fullTitle = title ? `${title} | Darragh Connolly Garden Care` : 'Darragh Connolly Garden Care | Gardener in Dublin & North Wicklow';
const path = Astro.url.pathname;
const seasons = JSON.stringify(months.map((m) => m.season));
const buildMonth = new Date().getMonth();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Darragh Connolly Garden Care',
  telephone: '+353872259319',
  email: contact.email,
  url: 'https://darraghconnolly.ie/',
  image: 'https://darraghconnolly.ie/img/garden-bench-panorama.jpg',
  areaServed: ['Dublin', 'Wicklow'],
  memberOf: [
    { '@type': 'Organization', name: 'Association of Landscape Contractors of Ireland' },
    { '@type': 'Organization', name: 'National Guild of Master Craftsmen' },
  ],
};
---

<!doctype html>
<html lang="en-IE" data-season={months[buildMonth].season}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eceee6" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/img/garden-bench-panorama.jpg', Astro.site)} />
    <meta property="og:locale" content="en_IE" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline define:vars={{ seasons }}>
      const r = document.documentElement;
      r.dataset.season = JSON.parse(seasons)[new Date().getMonth()];
      r.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="pill">
        <a class="brand" href="/" aria-label="Darragh Connolly Garden Care, home">
          <img src="/img/logo.png" alt="" width="432" height="296" />
        </a>
        <nav class="nav" aria-label="Main">
          <ul>
            {
              nav.map((item) =>
                item.href === '/services/' ? (
                  <li class="has-sub">
                    <details class="sub">
                      <summary aria-current={path.startsWith('/services/') ? 'page' : undefined}>
                        Services
                        <svg viewBox="0 0 24 24" class="chev" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                      </summary>
                      <ul class="sub-list">
                        {serviceMenu.map((s) => (
                          <li><a href={s.href}>{s.label}</a></li>
                        ))}
                        <li class="sub-all"><a href="/services/">All services</a></li>
                      </ul>
                    </details>
                  </li>
                ) : (
                  <li>
                    <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ),
              )
            }
          </ul>
        </nav>
        <a class="masthead-phone" href={contact.phoneHref}>
          <Icon name="phone" />
          <span>{contact.phone}</span>
        </a>
        <details class="menu">
          <summary aria-label="Menu">
            <Icon name="menu" class="i-open" />
            <Icon name="close" class="i-close" />
          </summary>
          <div class="menu-panel">
            <ul>
              <li><a href="/">Home</a></li>
              {
                nav.map((item) =>
                  item.href === '/services/' ? (
                    <li>
                      <a href="/services/">Services</a>
                      <ul class="menu-sub">
                        {serviceMenu.map((s) => (
                          <li><a href={s.href}>{s.label}</a></li>
                        ))}
                      </ul>
                    </li>
                  ) : (
                    <li><a href={item.href}>{item.label}</a></li>
                  ),
                )
              }
            </ul>
            <a class="btn btn-leaf" href={contact.phoneHref}><Icon name="phone" /> Call {contact.phone}</a>
          </div>
        </details>
      </div>
    </header>

    {garden && <GardenBackdrop />}

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <p class="footer-lead">Your garden, looked after all year.</p>
          <a class="btn btn-leaf" href="/contact/">Get a quote <Icon name="arrow" /></a>
        </div>
        <div>
          <h2 class="footer-h">Services</h2>
          <ul>
            {services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="footer-h">Visit</h2>
          <ul>
            {nav.filter((n) => n.href !== '/services/').map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="footer-h">Talk to Darragh</h2>
          <ul class="footer-contact">
            <li><a href={contact.phoneHref}><Icon name="phone" /> {contact.phone}</a></li>
            <li><a href={`mailto:${contact.email}`}><Icon name="mail" /> {contact.email}</a></li>
            <li><Icon name="pin" /> {contact.area}</li>
          </ul>
        </div>
      </div>
      <div class="wrap footer-base">
        <p>© {new Date().getFullYear()} Darragh Connolly Garden Care</p>
        <p>Member of ALCI and the National Guild of Master Craftsmen</p>
      </div>
      <p class="footer-mark" aria-hidden="true">Darragh Connolly</p>
    </footer>

    {callbar && <a class="callbar" href={contact.phoneHref}><Icon name="phone" /> Call Darragh</a>}

    <script>
      const header = document.querySelector('.masthead');
      const onScroll = () => header?.classList.toggle('scrolled', scrollY > 24);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      const sub = document.querySelector<HTMLDetailsElement>('.sub');
      document.addEventListener('click', (e) => {
        if (sub?.open && (!sub.contains(e.target as Node) || (e.target as Element).closest('a'))) sub.open = false;
      });

      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Typewriter for [data-type] headings: the text is in the HTML, JS only hides and reveals it.
      const typeIt = (el: HTMLElement) => {
        const text = el.textContent ?? '';
        el.setAttribute('aria-label', text);
        el.textContent = '';
        const chars = [...text].map((c) => {
          const s = document.createElement('span');
          s.className = 'tc';
          s.textContent = c;
          s.setAttribute('aria-hidden', 'true');
          el.append(s);
          return s;
        });
        const caret = document.createElement('span');
        caret.className = 'caret';
        caret.setAttribute('aria-hidden', 'true');
        el.prepend(caret);
        const speed = Number(el.dataset.speed) || 34;
        let i = 0;
        const step = () => {
          if (i < chars.length) {
            const c = chars[i++];
            c.classList.add('on');
            c.after(caret);
            setTimeout(step, speed + (/[,.?]/.test(c.textContent ?? '') ? 260 : Math.random() * 30));
          } else {
            setTimeout(() => caret.classList.add('done'), 1400);
          }
        };
        step();
      };

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            if (el.hasAttribute('data-type')) typeIt(el);
            else el.classList.add('in');
            io.unobserve(el);
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
      );
      document
        .querySelectorAll<HTMLElement>(reduce ? '[data-reveal], [data-pop]' : '[data-reveal], [data-pop], [data-type]')
        .forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    background: var(--leaf);
    color: var(--ink);
    padding: 0.75rem 1rem;
    border-radius: 8px;
  }
  .skip:focus {
    top: 1rem;
  }

  main {
    padding-top: 5.75rem;
  }

  .masthead {
    position: fixed;
    inset: 0.75rem 0 auto;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding-inline: 0.75rem;
    pointer-events: none;
  }
  .pill {
    pointer-events: auto;
    width: min(100%, 76rem);
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4.25rem;
    padding: 0.4rem 0.5rem 0.4rem 1.25rem;
    background: rgb(29 58 42 / 0.94);
    color: var(--on-evergreen);
    border-radius: 999px;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.06) inset,
      0 12px 32px -14px rgb(10 25 16 / 0.55);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    transition:
      width 500ms var(--ease-out),
      min-height 500ms var(--ease-out);
  }
  .masthead.scrolled .pill {
    width: min(100%, 64rem);
    min-height: 3.6rem;
  }
  .brand img {
    height: 3.1rem;
    width: auto;
    transition: height 500ms var(--ease-out);
  }
  .masthead.scrolled .brand img {
    height: 2.6rem;
  }
  .nav {
    margin-left: auto;
  }
  .nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    display: block;
    text-decoration: none;
    font-weight: 550;
    font-size: 0.98rem;
    color: var(--on-evergreen-2);
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    transition:
      color 200ms,
      background-color 200ms;
  }
  .nav a:hover {
    color: var(--on-evergreen);
    background: rgb(255 255 255 / 0.07);
  }
  .nav a[aria-current='page'] {
    color: var(--on-evergreen);
    background: rgb(255 255 255 / 0.12);
  }
  .has-sub {
    position: relative;
  }
  .sub summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    cursor: pointer;
    font-weight: 550;
    font-size: 0.98rem;
    color: var(--on-evergreen-2);
    padding: 0.55rem 0.8rem 0.55rem 0.9rem;
    border-radius: 999px;
    transition:
      color 200ms,
      background-color 200ms;
    -webkit-tap-highlight-color: transparent;
  }
  .sub summary::-webkit-details-marker {
    display: none;
  }
  .sub summary:hover,
  .sub[open] summary {
    color: var(--on-evergreen);
    background: rgb(255 255 255 / 0.07);
  }
  .sub summary[aria-current='page'] {
    color: var(--on-evergreen);
    background: rgb(255 255 255 / 0.12);
  }
  .chev {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 300ms var(--ease-out);
  }
  .sub[open] .chev {
    transform: rotate(180deg);
  }
  .nav .sub-list {
    position: absolute;
    top: calc(100% + 0.9rem);
    left: 50%;
    width: 17rem;
    display: grid;
    gap: 0.1rem;
    padding: 0.5rem;
    margin: 0;
    list-style: none;
    background: #fbfbf7;
    border: 1px solid var(--border);
    border-radius: 18px;
    box-shadow: 0 24px 48px -20px rgb(10 25 16 / 0.45);
    transform: translateX(-50%);
    animation: sub-in 320ms var(--ease-out);
  }
  @keyframes sub-in {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(-6px) scale(0.98);
    }
  }
  .nav .sub-list a {
    display: block;
    color: var(--ink);
    padding: 0.65rem 0.85rem;
    border-radius: 12px;
    font-size: 0.97rem;
  }
  .nav .sub-list a:hover {
    background: var(--paper-2);
    color: var(--ink);
  }
  .nav .sub-all a {
    color: var(--leaf-ink);
    font-weight: 650;
  }
  .masthead-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    color: var(--ink);
    background: var(--leaf);
    border-radius: 999px;
    padding: 0.8rem 1.2rem;
    white-space: nowrap;
    transition: background-color 200ms;
  }
  .masthead-phone:hover {
    background: #9ed356;
  }
  @media (max-width: 1100px) {
    .masthead-phone span {
      display: none;
    }
    .masthead-phone {
      padding: 0.8rem;
    }
    .pill {
      gap: 0.75rem;
    }
    .nav a,
    .sub summary {
      padding-inline: 0.65rem;
    }
  }
  .menu {
    display: none;
  }

  @media (max-width: 700px) {
    main {
      padding-top: 5rem;
    }
    .masthead {
      inset: 0.5rem 0 auto;
      padding-inline: 0.5rem;
    }
    .nav,
    .masthead-phone {
      display: none;
    }
    .pill,
    .masthead.scrolled .pill {
      width: 100%;
      min-height: 3.75rem;
      justify-content: space-between;
      border-radius: 22px;
    }
    .brand img,
    .masthead.scrolled .brand img {
      height: 2.6rem;
    }
    .menu {
      display: block;
    }
    .menu summary {
      list-style: none;
      width: 3rem;
      height: 3rem;
      display: grid;
      place-items: center;
      cursor: pointer;
      border-radius: 999px;
      background: rgb(255 255 255 / 0.08);
      -webkit-tap-highlight-color: transparent;
    }
    .menu summary::-webkit-details-marker {
      display: none;
    }
    .menu summary :global(svg) {
      width: 1.5rem;
      height: 1.5rem;
    }
    .menu :global(.i-close),
    .menu[open] :global(.i-open) {
      display: none;
    }
    .menu[open] :global(.i-close) {
      display: block;
    }
    .menu-panel {
      position: absolute;
      left: 0.5rem;
      right: 0.5rem;
      top: calc(100% + 0.5rem);
      background: var(--evergreen);
      padding: 0.75rem 1.25rem 1.25rem;
      border-radius: 22px;
      box-shadow: 0 24px 40px -16px rgb(10 25 16 / 0.6);
      animation: drop 380ms var(--ease-out);
    }
    @keyframes drop {
      from {
        opacity: 0;
        transform: translateY(-8px) scale(0.98);
      }
    }
    .menu-panel ul {
      list-style: none;
      margin: 0 0 1rem;
      padding: 0;
    }
    .menu-panel li a {
      display: block;
      padding: 0.75rem 0;
      font-family: var(--display);
      font-weight: 650;
      font-size: 1.7rem;
      text-decoration: none;
      border-bottom: 1px solid var(--evergreen-2);
    }
    .menu-panel .btn {
      width: 100%;
    }
    .menu-sub {
      list-style: none;
      margin: 0 0 0.5rem;
      padding: 0.25rem 0 0.25rem 1rem;
      border-left: 2px solid var(--evergreen-2);
    }
    .menu-panel .menu-sub a {
      font-family: var(--text);
      font-size: 1.05rem;
      font-weight: 500;
      padding: 0.45rem 0;
      border: 0;
      color: var(--on-evergreen-2);
    }
    .menu-panel {
      max-height: calc(100svh - 6rem);
      overflow-y: auto;
    }
  }

  .footer {
    background: var(--evergreen);
    color: var(--on-evergreen-2);
    padding-top: clamp(4rem, 8vw, 6rem);
    overflow: hidden;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 2.5rem;
  }
  .footer-brand {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    align-content: start;
  }
  .footer-lead {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--on-evergreen);
    max-width: 12ch;
  }
  .footer-h {
    font-family: var(--text);
    font-size: 0.95rem;
    font-weight: 650;
    color: var(--on-evergreen);
    letter-spacing: 0;
    margin-bottom: 0.9rem;
  }
  .footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .footer a {
    text-decoration: none;
  }
  .footer a:not(.btn):hover {
    color: var(--on-evergreen);
  }
  .footer-contact li,
  .footer-contact a {
    display: inline-flex;
    gap: 0.5rem;
    align-items: flex-start;
    overflow-wrap: anywhere;
  }
  .footer-contact :global(svg) {
    color: var(--leaf);
    margin-top: 0.25rem;
  }
  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--evergreen-2);
    font-size: 0.9rem;
  }
  .footer-mark {
    font-family: var(--display);
    font-weight: 600;
    font-size: 15.5vw;
    line-height: 0.8;
    letter-spacing: -0.045em;
    white-space: nowrap;
    text-align: center;
    color: var(--evergreen-2);
    margin: 2rem 0 -2.2vw;
    user-select: none;
  }
  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }

  .callbar {
    display: none;
  }
  @media (max-width: 700px) {
    .callbar {
      position: fixed;
      z-index: 60;
      right: 1rem;
      bottom: calc(1rem + env(safe-area-inset-bottom));
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--leaf);
      color: var(--ink);
      font-weight: 650;
      text-decoration: none;
      padding: 0.9rem 1.25rem;
      border-radius: 999px;
      box-shadow: 0 10px 24px -8px rgb(10 25 16 / 0.5);
    }
  }
</style>
