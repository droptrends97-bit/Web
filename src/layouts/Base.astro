---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { contact, nav, services, months } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  callbar?: boolean;
}

const {
  title,
  callbar = true,
  description = 'Garden care and maintenance across Dublin and North Wicklow. Regular visits, seasonal Garden Interventions, lawn and soil health, and designed pots and planters.',
} = Astro.props;

const fullTitle = title ? `${title} | Darragh Connolly Garden Care` : 'Darragh Connolly Garden Care | Gardener in Dublin & North Wicklow';
const path = Astro.url.pathname;
const seasons = JSON.stringify(months.map((m) => m.season));
const buildMonth = new Date().getMonth();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Darragh Connolly Garden Care',
  telephone: '+353872259319',
  email: contact.email,
  url: 'https://darraghconnolly.ie/',
  image: 'https://darraghconnolly.ie/img/garden-bench-panorama.jpg',
  areaServed: ['Dublin', 'Wicklow'],
  memberOf: [
    { '@type': 'Organization', name: 'Association of Landscape Contractors of Ireland' },
    { '@type': 'Organization', name: 'National Guild of Master Craftsmen' },
  ],
};
---

<!doctype html>
<html lang="en-IE" data-season={months[buildMonth].season}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1d3a2a" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/img/garden-bench-panorama.jpg', Astro.site)} />
    <meta property="og:locale" content="en_IE" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline define:vars={{ seasons }}>
      document.documentElement.dataset.season = JSON.parse(seasons)[new Date().getMonth()];
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="wrap masthead-row">
        <a class="brand" href="/" aria-label="Darragh Connolly Garden Care, home">
          <img src="/img/logo.png" alt="" width="432" height="296" />
        </a>
        <nav class="nav" aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a class="masthead-phone" href={contact.phoneHref}>
          <Icon name="phone" />
          <span>{contact.phone}</span>
        </a>
        <details class="menu">
          <summary aria-label="Menu">
            <Icon name="menu" class="i-open" />
            <Icon name="close" class="i-close" />
          </summary>
          <div class="menu-panel">
            <ul>
              <li><a href="/">Home</a></li>
              {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            </ul>
            <a class="btn btn-leaf" href={contact.phoneHref}><Icon name="phone" /> Call {contact.phone}</a>
          </div>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <img src="/img/logo.png" alt="Darragh Connolly Garden Care" width="432" height="296" loading="lazy" />
          <p>Garden care across {contact.area}.</p>
        </div>
        <div>
          <h2 class="footer-h">Services</h2>
          <ul>
            {services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="footer-h">Visit</h2>
          <ul>
            {nav.filter((n) => n.href !== '/services/').map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="footer-h">Talk to Darragh</h2>
          <ul class="footer-contact">
            <li><a href={contact.phoneHref}><Icon name="phone" /> {contact.phone}</a></li>
            <li><a href={`mailto:${contact.email}`}><Icon name="mail" /> {contact.email}</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap footer-base">
        <p>© {new Date().getFullYear()} Darragh Connolly Garden Care</p>
        <p>Member of ALCI and the National Guild of Master Craftsmen</p>
      </div>
    </footer>

    {callbar && <a class="callbar" href={contact.phoneHref}><Icon name="phone" /> Call Darragh</a>}
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    background: var(--leaf);
    color: var(--ink);
    padding: 0.75rem 1rem;
    border-radius: 8px;
  }
  .skip:focus {
    top: 1rem;
  }

  .masthead {
    background: var(--evergreen);
    color: var(--on-evergreen);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .masthead-row {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 4.75rem;
  }
  .brand img {
    height: 4.25rem;
    width: auto;
  }
  .nav {
    margin-left: auto;
  }
  .nav ul {
    display: flex;
    gap: clamp(1rem, 2vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    text-decoration: none;
    font-weight: 550;
    font-size: 1rem;
    color: var(--on-evergreen-2);
    padding-block: 0.5rem;
    position: relative;
    transition: color 200ms;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--leaf);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 260ms var(--ease-out);
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--on-evergreen);
  }
  .nav a:hover::after,
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .masthead-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    color: var(--ink);
    background: var(--leaf);
    border-radius: 999px;
    padding: 0.6rem 1.1rem;
    white-space: nowrap;
  }
  .masthead-phone :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .menu {
    display: none;
  }

  @media (max-width: 960px) {
    .nav,
    .masthead-phone {
      display: none;
    }
    .masthead-row {
      min-height: 4rem;
      justify-content: space-between;
    }
    .brand img {
      height: 3rem;
    }
    .menu {
      display: block;
    }
    .menu summary {
      list-style: none;
      width: 3rem;
      height: 3rem;
      display: grid;
      place-items: center;
      cursor: pointer;
      border-radius: 999px;
      -webkit-tap-highlight-color: transparent;
    }
    .menu summary::-webkit-details-marker {
      display: none;
    }
    .menu summary :global(svg) {
      width: 1.6rem;
      height: 1.6rem;
    }
    .menu :global(.i-close),
    .menu[open] :global(.i-open) {
      display: none;
    }
    .menu[open] :global(.i-close) {
      display: block;
    }
    .menu-panel {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      background: var(--evergreen);
      padding: 0.5rem var(--gutter) 1.5rem;
      border-top: 1px solid var(--evergreen-2);
      box-shadow: 0 18px 30px -12px rgb(10 25 16 / 0.45);
    }
    .menu-panel ul {
      list-style: none;
      margin: 0 0 1.25rem;
      padding: 0;
    }
    .menu-panel li a {
      display: block;
      padding: 0.8rem 0;
      font-family: var(--display);
      font-stretch: 80%;
      font-weight: 650;
      font-size: 1.6rem;
      text-decoration: none;
      border-bottom: 1px solid var(--evergreen-2);
    }
    .menu-panel .btn {
      width: 100%;
    }
  }

  .footer {
    background: var(--evergreen);
    color: var(--on-evergreen-2);
    padding-block: 4rem 6rem;
    margin-top: 0;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 2.5rem;
  }
  .footer-brand img {
    height: 5rem;
    width: auto;
    margin-bottom: 1rem;
  }
  .footer-brand p {
    max-width: 28ch;
  }
  .footer-h {
    font-family: var(--text);
    font-stretch: 100%;
    font-size: 0.95rem;
    font-weight: 650;
    color: var(--on-evergreen);
    letter-spacing: 0;
    margin-bottom: 0.9rem;
  }
  .footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .footer a {
    text-decoration: none;
  }
  .footer a:hover {
    color: var(--on-evergreen);
    text-decoration: underline;
  }
  .footer-contact a {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    overflow-wrap: anywhere;
  }
  .footer-contact :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
    color: var(--leaf);
  }
  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--evergreen-2);
    font-size: 0.9rem;
  }
  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }

  .callbar {
    display: none;
  }
  @media (max-width: 960px) {
    .callbar {
      position: fixed;
      z-index: 60;
      right: 1rem;
      bottom: calc(1rem + env(safe-area-inset-bottom));
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--leaf);
      color: var(--ink);
      font-weight: 650;
      text-decoration: none;
      padding: 0.9rem 1.25rem;
      border-radius: 999px;
      box-shadow: 0 10px 24px -8px rgb(10 25 16 / 0.5);
    }
    .callbar :global(svg) {
      width: 1.2rem;
      height: 1.2rem;
    }
  }
</style>
