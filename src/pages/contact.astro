---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Split from '../components/Split.astro';
import { contact, services, reviews, visitOptions } from '../data/site';

const areas = [...new Set(reviews.map((r) => r.place.split(',')[0]))];
const lengths = visitOptions.map((v) => v.length);
const next = [
  {
    title: 'You get in touch',
    text: 'Call, email or send the form. Tell us where the garden is and what it needs.',
  },
  {
    title: 'Darragh visits and listens',
    text: 'He walks the garden with you, talks about how you use it, and looks at what it needs now and through the year.',
  },
  {
    title: 'We plan your schedule',
    text: 'Monthly, fortnightly or weekly visits, from 1.5 hours to a full day, always with a team of two gardeners.',
  },
];
---

<Base
  garden
  title="Contact"
  callbar={false}
  description="Talk to Darragh Connolly Garden Care about your garden: call 087 225 9319, email info@darraghconnolly.ie or send a request for a visit."
>
  <section class="wrap c-hero" aria-labelledby="contact-title">
    <div class="c-copy">
      <span class="eyebrow" data-reveal>Contact</span>
      <h1 id="contact-title" class="ink" style="--n:27" aria-label="Let's talk about your garden."><Split text="Let's talk about your garden." letters /><span class="swash" aria-hidden="true"><svg viewBox="0 0 300 24" preserveAspectRatio="none"><path d="M4 16C60 6 120 4 180 9s90 8 116-2" /></svg></span></h1>
      <p class="lede c-lede">
        Whether it's regular care, a seasonal intervention or planted pots, tell us about the garden and Darragh will
        arrange a visit to see it with you.
      </p>
      <ul class="c-direct" data-stagger="rise">
        <li>
          <a href={contact.phoneHref}>
            <span class="c-icon"><Icon name="phone" /></span>
            <span><small>Call Darragh</small><strong>{contact.phone}</strong></span>
            <Icon name="arrow" />
          </a>
        </li>
        <li>
          <a href={`mailto:${contact.email}`}>
            <span class="c-icon"><Icon name="mail" /></span>
            <span><small>Email</small><strong>{contact.email}</strong></span>
            <Icon name="arrow" />
          </a>
        </li>
        <li>
          <div>
            <span class="c-icon"><Icon name="pin" /></span>
            <span><small>Where we work</small><strong>{contact.area}</strong></span>
          </div>
        </li>
      </ul>
    </div>
    <figure class="c-photo" data-curtain>
      <img src="/img/gal-18.jpg" alt="Alliums in flower in front of the Darragh Connolly Garden Care van." />
      <figcaption class="c-badge">
        <span class="c-badge-dot" aria-hidden="true"></span>
        Free discovery call before any work starts
      </figcaption>
    </figure>
  </section>

  <section class="wrap c-main" aria-labelledby="form-title">
    <form class="c-form" name="quote" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="company" data-reveal>
      <input type="hidden" name="form-name" value="quote" />
      <p class="visually-hidden">
        <label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label>
      </p>
      <h2 id="form-title" class="rise" aria-label="Tell us about your garden"><Split text="Tell us about your garden" /></h2>

      <div class="c-pair">
        <label class="c-field">
          <span>Your name</span>
          <input name="name" type="text" autocomplete="name" required />
        </label>
        <label class="c-field">
          <span>Phone</span>
          <input name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
        </label>
      </div>
      <div class="c-pair">
        <label class="c-field">
          <span>Email <em>(optional)</em></span>
          <input name="email" type="email" autocomplete="email" />
        </label>
        <label class="c-field">
          <span>Where is the garden?</span>
          <input name="area" type="text" autocomplete="address-level2" placeholder="e.g. Dalkey, Co. Dublin" required />
        </label>
      </div>

      <fieldset class="c-set">
        <legend>What would you like help with?</legend>
        <div class="c-chips">
          {services.map((s) => (
            <label class="c-chip">
              <input type="checkbox" name="interest" value={s.name} />
              <span>{s.name}</span>
            </label>
          ))}
          <label class="c-chip">
            <input type="checkbox" name="interest" value="Not sure yet" />
            <span>Not sure yet</span>
          </label>
        </div>
      </fieldset>

      <fieldset class="c-set">
        <legend>How long would a visit be? <em>(optional)</em></legend>
        <div class="c-chips">
          {lengths.map((l) => (
            <label class="c-chip">
              <input type="radio" name="visit" value={l} />
              <span>{l}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <label class="c-field">
        <span>About your garden</span>
        <textarea name="message" rows="5" placeholder="Size, what it needs, how often you'd like us to come…"></textarea>
      </label>

      <div class="c-submit">
        <button class="btn btn-leaf" type="submit">Send request <Icon name="arrow" /></button>
        <p>We use your details only to reply to you.</p>
      </div>

      <div id="contact-sent" class="c-sent" role="status">
        <strong>Thank you, your request is on its way.</strong>
        <span>Darragh will be in touch to arrange a visit. If it's urgent, call {contact.phone}.</span>
      </div>
    </form>

    <aside class="c-side">
      <div class="c-next">
        <h2 class="rise" aria-label="What happens next"><Split text="What happens next" /></h2>
        <ol data-stagger="slide">
          {next.map((n, i) => (
            <li>
              <span class="c-num">{i + 1}</span>
              <div>
                <h3>{n.title}</h3>
                <p>{n.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="c-areas">
        <h3>Gardens we look after include</h3>
        <ul data-stagger="scatter">
          {[...areas, 'North Wicklow'].map((a) => (
            <li><Icon name="pin" /> {a}</li>
          ))}
        </ul>
      </div>
      <p class="c-note">We look after gardens, and that's all we do. We don't lay paving, paths or patios.</p>
    </aside>
  </section>
</Base>

<style>
  .c-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(2rem, 5vw, 4rem);
  }
  .c-copy {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }
  .eyebrow {
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: #dfe8d3;
    color: var(--leaf-ink);
    font-size: 0.85rem;
    font-weight: 650;
  }
  .c-copy h1 {
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 500;
    line-height: 0.98;
    max-width: 11ch;
  }
  .c-lede {
    max-width: 40ch;
  }
  .c-direct {
    display: grid;
    gap: 0.6rem;
    width: min(100%, 30rem);
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .c-direct a,
  .c-direct li > div {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1.1rem 0.85rem 0.85rem;
    border-radius: 20px;
    background: var(--card);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    color: var(--ink);
    text-decoration: none;
    transition: translate 250ms var(--ease-out), border-color 250ms;
  }
  .c-direct a:hover {
    translate: 4px 0;
    border-color: var(--leaf);
  }
  .c-direct small {
    display: block;
    color: var(--ink-2);
    font-size: 0.82rem;
  }
  .c-direct strong {
    display: block;
    font-size: 1.1rem;
    font-weight: 650;
    overflow-wrap: anywhere;
  }
  .c-icon {
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    background: var(--evergreen);
    color: var(--leaf);
  }
  .c-photo {
    position: relative;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: clip;
    box-shadow: var(--shadow);
  }
  .c-photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .c-badge {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.85rem 1.1rem;
    border-radius: 18px;
    background: rgb(12 30 20 / 0.55);
    border: 1px solid rgb(255 255 255 / 0.2);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    color: #fff;
    font-weight: 600;
  }
  .c-badge-dot {
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--leaf);
    box-shadow: 0 0 0 0 rgb(140 198 63 / 0.7);
    animation: c-pulse 2.4s ease-out infinite;
  }
  @keyframes c-pulse {
    70% {
      box-shadow: 0 0 0 10px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  .c-main {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
    padding-block: clamp(1rem, 3vw, 2rem) clamp(4rem, 8vw, 6rem);
  }
  .c-form {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border-radius: var(--radius-lg);
    background: var(--card);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .c-form h2 {
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    margin-bottom: 0.25rem;
  }
  .c-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .c-field {
    display: grid;
    gap: 0.45rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .c-field em,
  .c-set em {
    color: var(--ink-2);
    font-style: normal;
    font-weight: 500;
  }
  .c-field input,
  .c-field textarea {
    width: 100%;
    padding: 0.9rem 1rem;
    border-radius: 14px;
    border: 1.5px solid var(--border);
    background: var(--paper);
    font: inherit;
    font-weight: 500;
    color: var(--ink);
    transition: border-color 200ms, box-shadow 200ms, background-color 200ms;
  }
  .c-field textarea {
    resize: vertical;
  }
  .c-field input:focus,
  .c-field textarea:focus {
    outline: none;
    border-color: var(--evergreen);
    background: #fff;
    box-shadow: 0 0 0 4px rgb(140 198 63 / 0.25);
  }
  .c-set {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .c-set legend {
    margin-bottom: 0.65rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .c-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .c-chip {
    position: relative;
  }
  .c-chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .c-chip span {
    display: inline-block;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    border: 1.5px solid var(--border);
    background: var(--paper);
    font-size: 0.92rem;
    font-weight: 550;
    transition: background-color 200ms, color 200ms, border-color 200ms, scale 200ms;
  }
  .c-chip:hover span {
    border-color: var(--evergreen);
  }
  .c-chip input:checked + span {
    background: var(--evergreen);
    border-color: var(--evergreen);
    color: var(--on-evergreen);
    scale: 1.04;
  }
  .c-chip input:focus-visible + span {
    box-shadow: 0 0 0 4px rgb(140 198 63 / 0.35);
  }
  .c-submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .c-submit p {
    color: var(--ink-2);
    font-size: 0.9rem;
  }
  .c-sent {
    display: none;
    gap: 0.3rem;
    padding: 1rem 1.2rem;
    border-radius: 16px;
    background: #dfe8d3;
    color: var(--leaf-ink);
  }
  .c-sent:target,
  .c-sent.show {
    display: grid;
    animation: c-sent 600ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  @keyframes c-sent {
    from {
      opacity: 0;
      scale: 0.9;
    }
  }

  .c-side {
    display: grid;
    gap: 1.25rem;
  }
  .c-next {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: var(--evergreen);
    color: var(--on-evergreen);
  }
  .c-next h2 {
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    margin-bottom: 1.25rem;
  }
  .c-next ol {
    display: grid;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .c-next li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
  }
  .c-num {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--leaf);
    color: var(--ink);
    font-family: var(--serif);
    font-weight: 600;
  }
  .c-next h3 {
    font-size: 1.1rem;
    margin-bottom: 0.2rem;
  }
  .c-next p {
    color: var(--on-evergreen-2);
    font-size: 0.95rem;
  }
  .c-areas {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-radius: var(--radius-lg);
    background: #dfe8d3;
  }
  .c-areas h3 {
    font-size: 1.05rem;
    margin-bottom: 0.85rem;
  }
  .c-areas ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .c-areas li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    background: var(--card);
    font-weight: 600;
    font-size: 0.9rem;
    box-shadow: var(--shadow);
  }
  .c-areas :global(svg) {
    color: var(--leaf-ink);
  }
  .c-note {
    color: var(--ink-2);
    font-size: 0.95rem;
    padding-inline: 0.5rem;
  }

  @media (max-width: 900px) {
    .c-hero,
    .c-main {
      grid-template-columns: 1fr;
    }
    .c-photo img {
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 560px) {
    .c-pair {
      grid-template-columns: 1fr;
    }
  }
</style>
