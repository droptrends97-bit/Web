---
import Split from '../../components/Split.astro';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CallToAction from '../../components/CallToAction.astro';
import { contact, visitOptions } from '../../data/site';

const rhythms = [
  { name: 'Weekly', text: 'Ideal for high-touch gardens that benefit from consistent, refined attention.', per: 52, month: 4 },
  { name: 'Fortnightly', text: 'A perfect rhythm for gardens that thrive with thoughtful, regular upkeep.', per: 26, month: 2 },
  { name: 'Monthly', text: 'Gentle, consistent care to maintain elegance and order with minimal disruption.', per: 12, month: 1 },
];

const tasks = ['Precise pruning', 'Weeding', 'Lawn care', 'Subtle plant shaping', 'Lawn edges', 'Light hedge trimming', 'Border care', 'Green waste removal'];

const gallery = [
  { src: '/img/mw-1.jpg', alt: 'A shaded stone path through lush planting to a cottage window.' },
  { src: '/img/mw-2.jpg', alt: 'A terracotta urn framed by clipped box.' },
  { src: '/img/mw-3.jpg', alt: 'A colourful border of white hydrangeas, red and orange perennials.' },
  { src: '/img/mw-4.jpg', alt: 'Lupins and grasses above a dry-stone raised bed.' },
  { src: '/img/mw-5.jpg', alt: 'A curving lawn and planting with a sea view beyond.' },
  { src: '/img/mw-6.jpg', alt: 'A dark courtyard with a grass, climbers and hanging pots.' },
  { src: '/img/mw-7.jpg', alt: 'A red acer beside a white-edged lawn and pergola.' },
  { src: '/img/mw-8.jpg', alt: 'A garden seating area surrounded by lawn and trees.' },
];
---

<Base
  garden="care"
  title="Maintenance for Wellness"
  description="Garden care and maintenance across Dublin and Wicklow: weekly, fortnightly or monthly visits with tailored seasonal tasks, so your garden stays a source of calm all year."
>
  <section class="hero" aria-labelledby="mw-title">
    <div class="hero-card">
      <img class="hero-img" src="/img/gh-hero.jpg" alt="A striped lawn leading to a white bench, clipped bay trees and hydrangeas." />
      <div class="hero-copy">
        <a class="crumb" href="/services/">Services</a>
        <h1 id="mw-title" class="ink" style="--n:23" aria-label={"Maintenance for wellness."}><Split text={"Maintenance for wellness."} letters /><span class="swash" aria-hidden="true"><svg viewBox="0 0 300 24" preserveAspectRatio="none"><path d="M4 16C60 6 120 4 180 9s90 8 116-2" /></svg></span></h1>
        <p class="hero-lede">Tailored care to nurture your garden, and your peace of mind.</p>
        <div class="hero-actions">
          <a class="btn btn-leaf" href="#mw-rhythm">Choose your rhythm <Icon name="arrow" /></a>
          <a class="btn btn-glass" href={contact.phoneHref}><Icon name="phone" /> {contact.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap intro" aria-labelledby="mw-intro">
    <h2 id="mw-intro" class="intro-big" data-reveal>Your garden is more than an outdoor space. It's a living sanctuary.</h2>
    <p class="intro-body" data-reveal>
      Our Maintenance for Wellness service provides discreet, expert care to make sure your garden remains a source of calm,
      beauty and quiet joy throughout the year.
    </p>
  </section>

  <section class="wrap rhythm" id="mw-rhythm" aria-labelledby="rhythm-title">
    <div class="section-head">
      <h2 id="rhythm-title" class="rise" aria-label={"A schedule that suits your life"}><Split text={"A schedule that suits your life"} /></h2>
      <p class="lede">We tailor your visits to your lifestyle and the needs of your space.</p>
    </div>
    <ul class="rhythm-grid" data-stagger="flip">
      {
        rhythms.map((r, i) => (
          <li data-pop style={`--d:${i}`} class:list={{ featured: i === 1 }}>
            <span class="dots" aria-hidden="true">
              {[0, 1, 2, 3].map((k) => <i class:list={{ on: k < r.month }} />)}
              <small>a month</small>
            </span>
            <h3>{r.name} visits</h3>
            <p>{r.text}</p>
            <span class="per">About <span data-count style={`--to:${r.per}`}>{r.per}</span> visits a year</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="tasks" aria-labelledby="tasks-title">
    <div class="wrap tasks-grid">
      <div class="tasks-copy">
        <h2 id="tasks-title" class="rise" aria-label={"Every visit, tailored to the season"}><Split text={"Every visit, tailored to the season"} /></h2>
        <p data-reveal>
          Each visit includes tailored seasonal tasks, all delivered with care, respect and a deep understanding of natural
          flow and form. We bring all the tools, always with a team of two gardeners.
        </p>
      </div>
      <ul class="chips" data-stagger="scatter">
        {tasks.map((t, i) => <li data-pop style={`--d:${i}`}>{t}</li>)}
      </ul>
    </div>
  </section>

  <section class="wrap visits" aria-labelledby="visits-title">
    <h2 id="visits-title" data-reveal>Visit lengths</h2>
    <ul class="visit-row" data-stagger="rise">
      {
        visitOptions.map((v, i) => (
          <li data-pop style={`--d:${i}`}>
            <span class="v-len">{v.length}</span>
            <span class="v-team">{v.team}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="gallery" aria-labelledby="mw-gallery">
    <div class="wrap"><h2 id="mw-gallery" class="rise" aria-label={"Sanctuaries we look after"}><Split text={"Sanctuaries we look after"} /></h2></div>
    <ul class="mosaic wrap" data-stagger="grow">
      {gallery.map((g, i) => <li data-pop style={`--d:${i % 4}`}><img src={g.src} alt={g.alt} loading="lazy" /></li>)}
    </ul>
  </section>

  <CallToAction
    heading="Let's maintain your sanctuary."
    text="With elegance, ease and expert care. Call Darragh to talk through the right visit schedule for your garden."
  />
</Base>

<style>
  .hero { padding: 0.75rem clamp(0.5rem, 1.5vw, 1rem) 0; }
  .hero-card {
    position: relative; max-width: calc(var(--max) + 4rem); margin-inline: auto; border-radius: var(--radius-lg);
    overflow: clip; isolation: isolate; min-height: clamp(28rem, 44vw, 38rem); display: flex; align-items: flex-end; color: #f4f6ee;
  }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; z-index: -2; animation: settle-in 14s var(--ease-out) both; }
  @keyframes settle-in { from { transform: scale(1.12); } }
  .hero-card::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(12 26 17 / 0) 30%, rgb(12 26 17 / 0.5) 58%, rgb(12 26 17 / 0.88) 100%); }
  .hero-copy { padding: clamp(1.5rem, 5vw, 4rem); display: grid; gap: 1.25rem; justify-items: start; max-width: 56rem; }
  .crumb { font-weight: 600; font-size: 0.95rem; color: #f4f6ee; text-decoration: none; padding: 0.35rem 0.8rem; border-radius: 999px; background: rgb(255 255 255 / 0.14); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .hero h1 { font-size: clamp(2.9rem, 7vw, 6rem); line-height: 0.96; max-width: 12ch; }
  .hero-lede { font-size: clamp(1.15rem, 1.8vw, 1.4rem); color: #dfe5d8; }
  .hero-lede, .hero-actions { animation: rise-in 900ms var(--ease-out) both; }
  .hero-lede { animation-delay: 1500ms; }
  .hero-actions { animation-delay: 1800ms; }
  @keyframes rise-in { from { opacity: 0; transform: translateY(16px); filter: blur(6px); } }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .btn-glass { color: #f4f6ee; background: rgb(255 255 255 / 0.12); border: 1px solid rgb(255 255 255 / 0.3); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }

  .intro { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 1.5rem clamp(2rem, 6vw, 6rem); padding-block: clamp(4rem, 9vw, 7rem) clamp(2rem, 5vw, 3rem); align-items: end; }
  .intro-big { font-weight: 500; font-size: clamp(1.9rem, 3.8vw, 3.2rem); line-height: 1.1; letter-spacing: -0.045em; }
  .intro-body { color: var(--ink-2); font-size: 1.15rem; }

  .rhythm { padding-block: clamp(2rem, 5vw, 4rem); scroll-margin-top: 6rem; }
  .section-head { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 1rem clamp(2rem, 5vw, 5rem); align-items: end; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .rhythm-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .rhythm-grid li {
    background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.75rem; display: grid; gap: 0.75rem; align-content: start;
    box-shadow: var(--shadow); transition: transform 400ms var(--ease-out);
  }
  .rhythm-grid li:hover { transform: translateY(-6px); }
  .rhythm-grid li.featured { background: var(--evergreen); color: var(--on-evergreen); border-color: var(--evergreen); }
  .rhythm-grid li.featured p { color: var(--on-evergreen-2); }
  .rhythm-grid h3 { font-size: clamp(1.6rem, 2.6vw, 2.2rem); }
  .rhythm-grid p { color: var(--ink-2); }
  .per { font-weight: 600; font-size: 0.9rem; color: var(--leaf-ink); }
  .featured .per { color: var(--leaf); }
  .dots { display: flex; align-items: center; gap: 6px; margin-bottom: 0.5rem; font-size: 0.85rem; color: var(--ink-2); }
  .dots small { margin-left: 0.4rem; font-size: inherit; }
  .featured .dots { color: var(--on-evergreen-2); }
  .dots i { width: 14px; height: 14px; border-radius: 50%; background: var(--border); }
  .featured .dots i { background: rgb(255 255 255 / 0.15); }
  .dots i.on { background: var(--leaf); }

  .tasks { padding-block: clamp(3rem, 7vw, 5rem); }
  .tasks-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 2rem clamp(2rem, 6vw, 6rem); align-items: center; }
  .tasks-copy { display: grid; gap: 1.25rem; }
  .tasks-copy h2 { max-width: 13ch; }
  .tasks-copy p { color: var(--ink-2); font-size: 1.1rem; max-width: 50ch; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .chips li { padding: 0.8rem 1.2rem; border-radius: 999px; background: #dfe8d3; font-weight: 600; transition: background-color 200ms, transform 300ms var(--ease-out); }
  .chips li:hover { background: var(--leaf); transform: translateY(-3px); }

  .visits { padding-block: clamp(1rem, 3vw, 2rem) clamp(3rem, 6vw, 4rem); }
  .visits h2 { font-size: clamp(1.6rem, 3vw, 2.25rem); margin-bottom: 1.25rem; }
  .visit-row { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.75rem; }
  .visit-row li { background: var(--card); border: 1px solid var(--border); border-radius: 18px; padding: 1.1rem 1.2rem; display: grid; gap: 0.2rem; }
  .v-len { font-family: var(--display); font-weight: 600; font-size: clamp(1.4rem, 2.2vw, 1.8rem); letter-spacing: -0.04em; }
  .v-team { font-size: 0.9rem; color: var(--ink-2); }

  .gallery { padding-bottom: clamp(1rem, 3vw, 2rem); }
  .gallery h2 { margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .mosaic { list-style: none; margin: 0 auto; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 12rem; gap: 0.75rem; }
  .mosaic li { border-radius: 20px; overflow: clip; }
  .mosaic li:nth-child(1), .mosaic li:nth-child(6) { grid-row: span 2; }
  .mosaic li:nth-child(3), .mosaic li:nth-child(8) { grid-column: span 2; }
  .mosaic img { width: 100%; height: 100%; object-fit: cover; transition: transform 800ms var(--ease-out); }
  .mosaic li:hover img { transform: scale(1.06); }

  @media (max-width: 860px) {
    .intro, .section-head, .rhythm-grid, .tasks-grid { grid-template-columns: 1fr; }
    .visit-row { grid-template-columns: repeat(3, 1fr); }
    .mosaic { grid-template-columns: 1fr 1fr; grid-auto-rows: 10rem; }
  }
</style>
