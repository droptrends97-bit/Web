---
import Count from '../components/Count.astro';
import Split from '../components/Split.astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import YearRibbon from '../components/YearRibbon.astro';
import Proof from '../components/Proof.astro';
import CallToAction from '../components/CallToAction.astro';
import { contact, services, alsoOffer, visitOptions, months, nav, serviceMenu, reviews } from '../data/site';

// Figures from Darragh's own pages: years in gardens, team size, the year-round calendar, client reviews.
// The hero runs through the gardening year in four of Darragh's gardens.
const slides = [
  { src: '/img/stage-1-hero.jpg', season: 'Spring', note: 'Tulips along the lawn', origin: '70% 70%' },
  { src: '/img/stage-2-hero.jpg', season: 'Late spring', note: 'Bay standards over tulips', origin: '50% 40%' },
  { src: '/img/stage-3-hero.jpg', season: 'Summer evening', note: 'Roses around the terrace', origin: '30% 45%' },
  { src: '/img/stage-4-hero.jpg', season: 'High summer', note: 'Pleached hedging, freshly clipped', origin: '50% 60%' },
];

const stats = [
  { to: 20, suffix: '+', label: 'Years caring for gardens' },
  { to: 2, suffix: '', label: 'Gardeners on every visit' },
  { to: 12, suffix: '', label: 'Months of care a year' },
  { to: reviews.length, suffix: '', label: 'Client reviews' },
];

const [care, intervention, health, pots] = services;
const thisMonth = months[new Date().getMonth()];

const railPhotos = [
  ['gal-42', 'A lawn below a curved stone wall.'],
  ['gal-14', 'Lime-white panicle hydrangeas.'],
  ['gal-29', 'A curving brick path beside clipped hedging.'],
  ['pots-pink-hydrangea', 'Pink hydrangeas in a long trough.'],
  ['gal-24', 'An acer over a raised timber bed.'],
  ['gal-41', 'A box parterre beside a lawn.'],
  ['gal-16', 'A curved bench in a planted corner.'],
  ['bulb-11', 'Tulips along a lawn edge.'],
  ['gal-13', 'Silver birches and a white-flowering border.'],
  ['gal-38', 'Birch trees along a walled lawn.'],
  ['gal-35', 'Lobelia and a box ball in a brick planter.'],
  ['gal-02', 'A wide lawn framed by mature trees.'],
].map(([f, alt]) => ({ src: `/img/${f}.jpg`, alt }));

const ticker = ['Lawn care', 'Hedging', 'Bulb planting', 'Pots & planters', 'Pruning', 'Mulching', 'Garden health', 'Weeding', 'Border care', 'Power washing'];

const steps = [
  {
    title: 'We visit and listen',
    text: 'Darragh walks the garden with you, talks about how you use it, and looks at what it needs now and through the year.',
    image: '/img/bench-border.jpg',
    tone: 'paper',
  },
  {
    title: 'We plan your schedule',
    text: 'Monthly, fortnightly or weekly visits, from 1.5 hours to a full day, always with a team of two gardeners.',
    image: '/img/gal-07.jpg',
    tone: 'evergreen',
  },
  {
    title: 'We keep it right, all year',
    text: 'We bring all the tools, work efficiently and take the green waste away. You get to simply enjoy the garden.',
    image: '/img/gal-42.jpg',
    tone: 'soft',
  },
];

// The statement is written over letter by letter as it scrolls up the screen. Its letters are split
// into eight runs; each run starts writing when the paragraph passes the next point on screen.
const statementText =
  "We don't lay paving, paths or patios. We look after gardens, and that's all we do, so yours gets our full attention every single visit.";
const RUNS = 8;
const totalLetters = statementText.replace(/ /g, '').length;
const perRun = Math.ceil(totalLetters / RUNS);
let letterNo = 0;
const statement = statementText.split(' ').map((word) =>
  [...word].map((c) => {
    const n = letterNo++;
    const run = Math.floor(n / perRun);
    return { c, run, j: n - run * perRun };
  }),
);
---

<Base garden>
  <!-- Hero: one full-bleed garden, the title centred on it, the menu sitting on the photo. -->
  <section class="stage" aria-labelledby="hero-title">
    <div class="stage-photo" aria-hidden="true">
      {slides.map((sl, k) => (
        <img src={sl.src} alt="" style={`--k:${k};transform-origin:${sl.origin}`} fetchpriority={k === 0 ? 'high' : undefined} decoding="async" />
      ))}
    </div>
    <div class="stage-shade" aria-hidden="true"></div>

    <div class="stage-bar">
      <a class="stage-brand" href="/" aria-label="Darragh Connolly Garden Care, home">
        <img src="/img/logo.png" alt="" width="432" height="296" />
      </a>
      <nav class="stage-nav" aria-label="Main">
        <ul>
          {nav.map((item, i) =>
            item.href === '/services/' ? (
              <li class="stage-has-sub" style={`--i:${i}`}>
                <details class="stage-sub">
                  <summary>
                    Services
                    <svg viewBox="0 0 24 24" class="stage-chev" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                  </summary>
                  <ul class="stage-sub-list">
                    {serviceMenu.map((s, k) => (
                      <li style={`--k:${k}`}><a href={s.href}>{s.label}</a></li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li style={`--i:${i}`}><a href={item.href}>{item.label}</a></li>
            ),
          )}
        </ul>
      </nav>
      <a class="stage-call" href={contact.phoneHref}><Icon name="phone" /> <span>{contact.phone}</span></a>
    </div>

    <div class="stage-copy">
      <a class="stage-now" href="#year-title">
        <span class="now-dot" aria-hidden="true"></span>
        <span><strong>This {thisMonth.name}</strong> · {thisMonth.work[0].toLowerCase()}</span>
        <Icon name="arrow" />
      </a>
      <h1 id="hero-title" class="ink stage-title" aria-label="Your garden, looked after all year.">
        <span class="t1"><Split text="Your garden," letters /></span>
        <span class="t2"><Split text="looked after" letters start={12} /> <span class="hl"><Split text="all year." letters start={23} /><span class="swash" aria-hidden="true"><svg viewBox="0 0 300 24" preserveAspectRatio="none"><path d="M4 16C60 6 120 4 180 9s90 8 116-2" /></svg></span></span></span>
      </h1>
      <p class="stage-lede">
        Darragh Connolly and his team care for gardens across Dublin and North Wicklow: regular maintenance, seasonal
        interventions, lawn health and planted pots.
      </p>
      <div class="stage-actions">
        <a class="btn btn-leaf" href="/contact/">Get a quote <Icon name="arrow" /></a>
        <a class="btn stage-glass" href="/gallery/">Explore portfolio <Icon name="arrow" /></a>
      </div>
      <ul class="stage-stats" aria-label="At a glance">
        {stats.map((st, i) => (
          <li style={`--i:${i}`}>
            <strong><Count to={st.to} now delay={`${3 + i * 0.15}s`} />{st.suffix}</strong>
            <span>{st.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <nav class="stage-services" aria-label="Services">
      <span class="stage-services-label">What we do</span>
      <ul>
        {serviceMenu.map((s, i) => (
          <li style={`--i:${i}`}><a href={s.href}>{s.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="stage-season" aria-hidden="true">
      <div class="stage-season-text">
        {slides.map((sl, k) => (
          <p style={`--k:${k}`}><strong>{sl.season}</strong> {sl.note}</p>
        ))}
      </div>
      <div class="stage-bars">
        {slides.map((_, k) => <span class={`b${k}`}><i></i></span>)}
      </div>
    </div>
  </section>

  <!-- Ticker -->
  <div class="ticker marquee" aria-hidden="true" style="--speed: 50s; --gap: 2.5rem">
    {
      [0, 1].map(() => (
        <div class="marquee-track">
          {ticker.map((t, i) => (
            <span class="tick">
              {t}
              <svg viewBox="0 0 24 24" class="leaf"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14zM5 19l7-7" /></svg>
            </span>
          ))}
        </div>
      ))
    }
  </div>

  <YearRibbon />

  <!-- Services bento -->
  <section class="services" aria-labelledby="services-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="services-title" class="rise" aria-label={"How we look after a garden"}><Split text={"How we look after a garden"} /></h2>
        <p class="lede">Garden care is all we do. Start with a visit or a Garden Intervention, then keep it right with regular care.</p>
      </div>

      <div class="bento">
        <article class="tile tile-care" data-pop>
          <div class="care-top">
            <img src={care.image} alt={care.imageAlt} loading="lazy" />
            <div class="care-head">
              <h3><a href={`/services/${care.slug}/`}>{care.name}</a></h3>
              <p>{care.short}</p>
              <ul class="freq" data-stagger="scatter">
                <li data-pop style="--d:3">Monthly</li>
                <li data-pop style="--d:4">Fortnightly</li>
                <li data-pop style="--d:5">Weekly</li>
              </ul>
            </div>
          </div>
          <ul class="visits" data-stagger="rise">
            {
              visitOptions.map((v, i) => (
                <li data-pop style={`--d:${i + 2}`}>
                  <span class="v-len">{v.length}</span>
                  <span class="v-team">{v.team}</span>
                </li>
              ))
            }
          </ul>
          <a class="tile-link" href={`/services/${care.slug}/`}>What a visit includes <Icon name="arrow" /></a>
        </article>

        {
          [intervention, health, pots].map((s, i) => (
            <a class:list={['tile', 'tile-photo', `tile-${s.slug}`]} href={`/services/${s.slug}/`} data-pop style={`--d:${i + 1}`}>
              <img src={s.image} alt="" loading="lazy" />
              <span class="tile-body">
                <span class="tile-name">{s.name}</span>
                <span class="tile-short">{s.short}</span>
              </span>
              <span class="tile-go" aria-hidden="true">
                <Icon name="arrow" />
              </span>
            </a>
          ))
        }

        <div class="tile tile-also" data-pop style="--d:2">
          <p class="also-title">Also on the list</p>
          <ul class="also-chips" data-stagger="scatter">
            {alsoOffer.map((a, i) => <li data-pop style={`--d:${i + 3}`}>{a}</li>)}
          </ul>
          <a class="btn btn-leaf" href="/services/">All services <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works: stacking cards -->
  <section class="steps" aria-labelledby="steps-title">
    <div class="wrap">
      <h2 id="steps-title" class="steps-title rise" aria-label={"Three steps to a garden you don't have to worry about"}><Split text={"Three steps to a garden you don't have to worry about"} /></h2>
      <ol class="stack">
        {
          steps.map((s, i) => (
            <li class:list={['card', `tone-${s.tone}`]} style={`--i:${i}`} data-pop>
              <div class="card-copy">
                <span class="card-num" data-pop style="--d:3">{i + 1}</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
              <img src={s.image} alt="" loading="lazy" />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Statement: words light up on scroll -->
  <section class="statement" aria-label="What we don't do">
    <div class="wrap">
      <p class="statement-text" aria-label={statementText}>
        {statement.map((word, k) => (
          <Fragment>
            <span class="sw" aria-hidden="true">
              {word.map((l) => (
                <span class={`sc r${l.run}`} data-c={l.c} style={`--j:${l.j}`}>{l.c}</span>
              ))}
            </span>
            {k < statement.length - 1 && ' '}
          </Fragment>
        ))}
      </p>
    </div>
  </section>

  <Proof />

  <!-- About -->
  <section class="about" aria-labelledby="about-title">
    <div class="wrap about-grid">
      <figure class="plate about-plate" data-curtain>
        <img src="/img/gal-18.jpg" alt="Purple alliums in front of the Darragh Connolly Garden Care van." loading="lazy" />
      </figure>
      <div class="about-body" data-reveal style="--d:1">
        <h2 id="about-title" class="rise" aria-label={"He'll look after your garden like it's his own."}><Split text={"He'll look after your garden like it's his own."} /></h2>
        <p>
          Darragh's work is mainly in Dublin and North Wicklow. He carries out all work thoroughly, to the highest
          standard possible, and takes pride in doing so. The business has grown through referrals from clients who are
          happy with their gardens.
        </p>
        <a class="btn btn-ghost" href="/about/">About Darragh <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="strip-photos" aria-labelledby="gallery-title">
    <div class="wrap strip-head">
      <h2 id="gallery-title" class="rise" aria-label={"Gardens we look after"}><Split text={"Gardens we look after"} /></h2>
      <a class="btn btn-ghost" href="/gallery/">See the gallery <Icon name="arrow" /></a>
    </div>
    <div class="marquee photo-rail" style="--speed: 60s; --gap: 1rem">
      {
        [0, 1].map((k) => (
          <ul class="marquee-track" aria-hidden={k > 0 ? 'true' : undefined}>
            {railPhotos.map((p) => (
              <li><img src={p.src} alt={k === 0 ? p.alt : ''} loading="lazy" /></li>
            ))}
          </ul>
        ))
      }
    </div>
  </section>

  <CallToAction />

  <aside class="toast" role="status" aria-live="polite" hidden>
    <span class="toast-icon" aria-hidden="true"><Icon name="phone" /></span>
    <span class="toast-text"><strong>Planning {thisMonth.season} work?</strong> Darragh is on {contact.phone}</span>
    <a class="toast-go" href={contact.phoneHref}>Call</a>
    <button class="toast-x" type="button" aria-label="Dismiss"><Icon name="close" /></button>
  </aside>
</Base>

<script>
  // Close the hero's Services drop-down when a link is chosen or the visitor clicks elsewhere.
  const stageSub = document.querySelector<HTMLDetailsElement>('.stage-sub');
  document.addEventListener('click', (e) => {
    if (stageSub?.open && (!stageSub.contains(e.target as Node) || (e.target as Element).closest('a'))) stageSub.open = false;
  });

  // Where scroll-linked CSS isn't supported, hide the green bar while the hero is on screen.
  const stage = document.querySelector('.stage');
  if (stage && document.documentElement.classList.contains('js-io') && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => document.documentElement.classList.toggle('on-stage', e.intersectionRatio > 0.35), {
      threshold: [0, 0.35, 1],
    }).observe(stage);
  }

  // A small note that pops up once per visit.
  const toast = document.querySelector<HTMLElement>('.toast');
  if (toast) {
    let seen = false;
    try {
      seen = sessionStorage.getItem('dc-toast') === '1';
    } catch {}
    if (!seen) {
      // The hero already carries the phone number, so the note waits until the visitor has scrolled past it.
      const reveal = () => {
        if (scrollY < innerHeight * 0.8) return;
        removeEventListener('scroll', reveal);
        setTimeout(() => {
          toast.hidden = false;
          requestAnimationFrame(() => toast.classList.add('show'));
        }, 1200);
      };
      addEventListener('scroll', reveal, { passive: true });
    }
    toast.querySelector('.toast-x')?.addEventListener('click', () => {
      toast.classList.remove('show');
      setTimeout(() => (toast.hidden = true), 400);
      try {
        sessionStorage.setItem('dc-toast', '1');
      } catch {}
    });
  }

  // Spotlight that follows the pointer across bento tiles.
  document.querySelectorAll<HTMLElement>('.tile').forEach((tile) => {
    tile.addEventListener('pointermove', (e) => {
      const r = tile.getBoundingClientRect();
      tile.style.setProperty('--mx', `${e.clientX - r.left}px`);
      tile.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>

<style>
  /* Hero */
  .stage {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto 1fr auto;
    grid-template-columns: minmax(0, 1fr);
    /* Edge to edge and the full height of the screen, tucked under where the green bar would sit. */
    margin-top: -5.75rem;
    min-height: max(100svh, 42rem);
    overflow: clip;
    color: #fff;
    background: var(--evergreen);
  }
  .stage-photo {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  /* Four gardens through the year, each slowly drifting in and handing over to the next.
     The whole cycle is 32s: 8s a garden, with a soft crossfade between them. */
  .stage-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.08) contrast(1.03);
    opacity: 0;
    animation: slide 32s linear infinite both;
    animation-delay: calc(var(--k) * 8s);
  }
  @keyframes slide {
    0% { opacity: 0; scale: 1.08; }
    4% { opacity: 1; }
    25% { opacity: 1; }
    30% { opacity: 0; scale: 1; }
    100% { opacity: 0; scale: 1; }
  }
  .stage-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Just enough shade for the words to read; the photos stay bright and warm. */
    background:
      radial-gradient(56% 50% at 50% 50%, rgb(10 26 16 / 0.58), rgb(10 26 16 / 0.22) 62%, transparent 82%),
      linear-gradient(180deg, rgb(10 26 16 / 0.5) 0%, rgb(10 26 16 / 0) 20%, rgb(10 26 16 / 0) 52%, rgb(10 26 16 / 0.7) 100%);
  }

  /* Which garden and season is showing, with a bar for each one filling as it plays. */
  .stage-season {
    position: absolute;
    right: clamp(1.1rem, 2.6vw, 2.25rem);
    top: clamp(5.75rem, 9vw, 7rem);
    display: grid;
    gap: 0.6rem;
    width: min(15rem, 60vw);
    text-align: right;
    animation: fade-up 900ms var(--ease-out) 3600ms both;
  }
  .stage-season-text {
    display: grid;
  }
  .stage-season-text p {
    grid-area: 1 / 1;
    margin: 0;
    color: rgb(255 255 255 / 0.9);
    font-size: 0.95rem;
    text-shadow: 0 1px 10px rgb(0 0 0 / 0.5);
    opacity: 0;
    animation: caption 32s linear infinite both;
    animation-delay: calc(var(--k) * 8s);
  }
  .stage-season-text strong {
    display: block;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--leaf);
  }
  @keyframes caption {
    0% { opacity: 0; translate: 0 10px; }
    4% { opacity: 1; translate: 0 0; }
    24% { opacity: 1; translate: 0 0; }
    28% { opacity: 0; translate: 0 -8px; }
    100% { opacity: 0; }
  }
  @media (max-width: 1040px) {
    .stage-season {
      display: none;
    }
  }
  .stage-bars {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.4rem;
  }
  .stage-bars span {
    height: 3px;
    border-radius: 3px;
    background: rgb(255 255 255 / 0.28);
    overflow: clip;
  }
  .stage-bars i {
    display: block;
    height: 100%;
    background: #fff;
    transform-origin: 0 50%;
    animation: 32s linear infinite both;
  }
  .b0 i { animation-name: bar0; }
  .b1 i { animation-name: bar1; }
  .b2 i { animation-name: bar2; }
  .b3 i { animation-name: bar3; }
  @keyframes bar0 { 0% { scale: 0 1; } 25% { scale: 1 1; } 99.9% { scale: 1 1; } 100% { scale: 0 1; } }
  @keyframes bar1 { 0%, 25% { scale: 0 1; } 50% { scale: 1 1; } 99.9% { scale: 1 1; } 100% { scale: 0 1; } }
  @keyframes bar2 { 0%, 50% { scale: 0 1; } 75% { scale: 1 1; } 99.9% { scale: 1 1; } 100% { scale: 0 1; } }
  @keyframes bar3 { 0%, 75% { scale: 0 1; } 100% { scale: 1 1; } }

  /* The menu, sitting straight on the photo. */
  .stage-bar {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1rem, 2vw, 1.5rem) clamp(1.1rem, 2.6vw, 2.25rem);
  }
  .stage-brand img {
    display: block;
    height: 3.3rem;
    width: auto;
    filter: drop-shadow(0 2px 10px rgb(0 0 0 / 0.35));
  }
  .stage-nav > ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.12);
    border: 1px solid rgb(255 255 255 / 0.22);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
  }
  .stage-nav > ul > li {
    animation: drop-in 700ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(1100ms + var(--i) * 70ms);
  }
  @keyframes drop-in {
    from {
      opacity: 0;
      translate: 0 -14px;
    }
  }
  .stage-nav a {
    display: block;
    padding: 0.6rem 1.05rem;
    border-radius: 999px;
    color: #fff;
    font-weight: 550;
    text-decoration: none;
    transition: background-color 200ms, color 200ms;
  }
  .stage-nav a:hover,
  .stage-sub summary:hover,
  .stage-sub[open] summary {
    background: #fff;
    color: var(--evergreen);
  }
  /* Services opens a drop-down of every service, on the photo. */
  .stage-has-sub {
    position: relative;
  }
  .stage-sub summary {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.6rem 0.9rem 0.6rem 1.05rem;
    border-radius: 999px;
    color: #fff;
    font-weight: 550;
    cursor: pointer;
    list-style: none;
    transition: background-color 200ms, color 200ms;
  }
  .stage-sub summary::-webkit-details-marker {
    display: none;
  }
  .stage-chev {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: rotate 250ms var(--ease-out);
  }
  .stage-sub[open] .stage-chev {
    rotate: 180deg;
  }
  .stage-sub-list {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 0;
    z-index: 10;
    display: grid;
    gap: 0.15rem;
    min-width: 17rem;
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    border-radius: 22px;
    background: rgb(16 38 26 / 0.94);
    border: 1px solid rgb(255 255 255 / 0.2);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    backdrop-filter: blur(18px) saturate(1.3);
    box-shadow: 0 30px 60px -24px rgb(0 0 0 / 0.55);
    transform-origin: 20% 0;
    animation: sub-open 320ms cubic-bezier(0.2, 0.9, 0.3, 1.2) both;
  }
  @keyframes sub-open {
    from {
      opacity: 0;
      scale: 0.92;
      translate: 0 -8px;
    }
  }
  .stage-sub-list li {
    animation: drop-in 420ms cubic-bezier(0.2, 0.9, 0.3, 1) both;
    animation-delay: calc(60ms + var(--k) * 35ms);
  }
  .stage-sub-list a {
    padding: 0.7rem 1rem;
    border-radius: 14px;
    font-size: 0.98rem;
  }
  .stage-sub-list a:hover {
    background: var(--leaf);
    color: var(--ink);
  }
  .stage-call {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.2rem;
    border-radius: 999px;
    background: var(--leaf);
    color: var(--ink);
    font-weight: 650;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    transition: background-color 200ms, scale 200ms;
  }
  .stage-call:hover {
    background: #9ed356;
    scale: 1.03;
  }

  /* The centred title block. */
  .stage-copy {
    align-self: center;
    justify-self: center;
    display: grid;
    justify-items: center;
    gap: clamp(1.1rem, 2.2vw, 1.6rem);
    width: min(100% - 2.5rem, 62rem);
    text-align: center;
    padding-bottom: clamp(1rem, 3vh, 2.5rem);
  }
  .stage-now {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.95rem 0.5rem 0.8rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.14);
    border: 1px solid rgb(255 255 255 / 0.25);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: #fff;
    font-size: 0.95rem;
    text-decoration: none;
    animation: pop-in 800ms cubic-bezier(0.34, 1.56, 0.64, 1) 700ms both;
  }
  .stage-now strong {
    color: var(--leaf);
  }
  .stage-now :global(svg) {
    transition: translate 220ms var(--ease-out);
  }
  .stage-now:hover :global(svg) {
    translate: 3px 0;
  }
  .now-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--leaf);
    box-shadow: 0 0 0 0 rgb(140 198 63 / 0.7);
    animation: pulse 2.4s var(--ease-out) infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 10px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  .stage-title {
    margin: 0;
    font-size: clamp(3rem, 7.6vw, 7.5rem);
    font-weight: 500;
    line-height: 0.98;
    text-shadow: 0 2px 6px rgb(0 0 0 / 0.35), 0 6px 40px rgb(0 0 0 / 0.45);
    padding-bottom: 0.12em;
  }
  .stage-title > span {
    display: block;
  }
  .stage-title :global(.ic) {
    animation-delay: calc(900ms + var(--i) * 45ms);
  }
  .hl {
    position: relative;
    display: inline-block;
    color: var(--leaf);
    font-style: italic;
  }
  .stage-title .swash {
    left: 0;
    width: 100%;
    bottom: -0.1em;
  }
  .stage-title .swash :global(path) {
    stroke: #fff;
    animation-delay: 2.4s;
  }
  .stage-lede {
    max-width: 44ch;
    margin: 0;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.55;
    color: rgb(255 255 255 / 0.88);
    text-shadow: 0 1px 16px rgb(0 0 0 / 0.4);
    animation: fade-up 900ms var(--ease-out) 2300ms both;
  }
  .stage-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    animation: pop-in 800ms cubic-bezier(0.34, 1.56, 0.64, 1) 2600ms both;
  }
  /* The figures, counting up once the title has written on. */
  .stage-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    width: min(100%, 52rem);
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .stage-stats li {
    display: grid;
    gap: 0.3rem;
    padding: 0.2rem 1rem;
    border-left: 1px solid rgb(255 255 255 / 0.25);
    animation: fade-up 800ms var(--ease-out) both;
    animation-delay: calc(2900ms + var(--i) * 120ms);
  }
  .stage-stats li:first-child {
    border-left: 0;
  }
  .stage-stats li {
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.55);
  }
  .stage-stats strong {
    font-family: var(--serif);
    font-size: clamp(2rem, 3.4vw, 3rem);
    font-weight: 500;
    line-height: 1;
    color: #fff;
  }
  .stage-stats li > span {
    font-size: 0.85rem;
    font-weight: 500;
    color: rgb(255 255 255 / 0.75);
  }
  .stage-glass {
    color: #fff;
    border-color: rgb(255 255 255 / 0.4);
    background: rgb(255 255 255 / 0.12);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    font-variant-numeric: tabular-nums;
  }
  .stage-glass:hover {
    background: #fff;
    color: var(--evergreen);
  }
  @keyframes pop-in {
    from {
      opacity: 0;
      transform: scale(0.85) translateY(12px);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
      filter: blur(6px);
    }
  }

  /* Every service along the foot of the photo. */
  .stage-services {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 clamp(0.75rem, 2vw, 1.5rem) clamp(0.75rem, 2vw, 1.5rem);
    padding: 0.5rem 0.5rem 0.5rem 1.25rem;
    border-radius: 999px;
    background: rgb(10 28 18 / 0.35);
    border: 1px solid rgb(255 255 255 / 0.18);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    backdrop-filter: blur(16px) saturate(1.3);
    animation: rise-bar 900ms cubic-bezier(0.2, 0.9, 0.2, 1) 3400ms both;
  }
  @keyframes rise-bar {
    from {
      opacity: 0;
      translate: 0 120%;
    }
  }
  .stage-services-label {
    flex: none;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--leaf);
  }
  .stage-services ul {
    display: flex;
    flex: 1;
    justify-content: space-between;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .stage-services li {
    flex: none;
    animation: pop-in 600ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(3700ms + var(--i) * 80ms);
  }
  .stage-services a {
    display: block;
    padding: 0.6rem 0.85rem;
    border-radius: 999px;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 550;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 200ms, color 200ms;
  }
  .stage-services a:hover {
    background: var(--leaf);
    color: var(--ink);
  }

  /* As you scroll away the photo settles back and the title lifts off. */
  @supports (animation-timeline: view()) {
    .stage-copy {
      animation: lift linear both;
      animation-timeline: view();
      animation-range: exit 0% exit 80%;
    }
    @keyframes lift {
      to {
        translate: 0 -18vh;
        opacity: 0;
        scale: 0.94;
      }
    }
  }

  /* While the hero is on screen the green bar steps aside; the menu is on the photo instead. */
  @media (min-width: 861px) {
    @supports (animation-timeline: view()) {
      :global(body) {
        timeline-scope: --stage;
      }
      .stage {
        view-timeline: --stage block;
      }
      :global(.masthead) {
        animation: masthead-drop linear both;
        animation-timeline: --stage;
        animation-range: exit 55% exit 85%;
      }
    }
    :global(html.on-stage .masthead) {
      translate: 0 -160%;
      opacity: 0;
    }
    :global(.masthead) {
      transition: translate 500ms var(--ease-out), opacity 300ms;
    }
  }
  @keyframes masthead-drop {
    from {
      translate: 0 -160%;
      opacity: 0;
      visibility: hidden;
    }
    to {
      translate: 0 0;
      opacity: 1;
      visibility: visible;
    }
  }

  /* When the services don't all fit, the strip scrolls sideways and fades at its end. */
  @media (max-width: 1500px) {
    .stage-services-label {
      display: none;
    }
    .stage-services {
      padding-left: 0.5rem;
    }
  }
  @media (max-width: 1340px) {
    .stage-services ul {
      justify-content: flex-start;
      -webkit-mask-image: linear-gradient(90deg, #000 88%, transparent);
      mask-image: linear-gradient(90deg, #000 88%, transparent);
      padding-right: 3rem;
    }
  }
  /* On phones and small tablets the regular menu stays, and the photo sits under it. */
  @media (max-width: 860px) {
    .stage {
      min-height: 100svh;
    }
  }
  @media (max-width: 700px) {
    .stage {
      margin-top: -5rem;
    }
  }
  @media (max-width: 860px) {
    .stage-bar {
      display: none;
    }
    .stage-copy {
      padding-block: 7rem 2rem;
      grid-row: 1 / 3;
    }
    .stage-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 1.25rem;
    }
    .stage-stats li:nth-child(3) {
      border-left: 0;
    }
    .stage-services {
      border-radius: 22px;
      padding: 0.4rem;
    }
  }
  @media (max-width: 1180px) and (min-width: 861px) {
    .stage-nav a {
      padding-inline: 0.75rem;
    }
  }
  @media (max-width: 1040px) and (min-width: 861px) {
    .stage-call span {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stage-photo img {
      animation: none;
    }
    .stage-photo img:first-child,
    .stage-season-text p:first-child {
      opacity: 1;
    }
    .stage,
    .stage-season-text p,
    .stage-bars i,
    .stage-copy,
    .stage-nav li,
    .stage-services,
    .stage-services li,
    .stage-stats li,
    .stage-now,
    .stage-lede,
    .stage-actions {
      animation: none;
    }
  }

  /* Ticker */
  .ticker {
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-block: 1px solid var(--rule);
    margin-bottom: clamp(1rem, 3vw, 2rem);
  }
  .tick {
    display: inline-flex;
    align-items: center;
    gap: 2.5rem;
    white-space: nowrap;
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(2rem, 4.5vw, 3.75rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
    color: color-mix(in srgb, var(--ink) 30%, transparent);
  }
  .tick:nth-child(3n + 1) {
    color: var(--ink);
  }
  .leaf {
    width: 0.6em;
    height: 0.6em;
    fill: var(--leaf);
    stroke: var(--evergreen);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  /* Services bento */
  .services {
    padding-block: clamp(4rem, 9vw, 7.5rem);
  }
  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 1.25rem clamp(2rem, 5vw, 5rem);
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .section-head h2 {
    max-width: 12ch;
  }
  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: minmax(15rem, auto);
    gap: 1rem;
  }
  .tile {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: clip;
    isolation: isolate;
  }
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(420px circle at var(--mx, -100px) var(--my, -100px), rgb(255 255 255 / 0.16), transparent 45%);
    opacity: 0;
    transition: opacity 300ms;
    pointer-events: none;
    z-index: 2;
  }
  .tile:hover::after {
    opacity: 1;
  }

  .tile-care {
    grid-column: 1 / 5;
    grid-row: span 2;
    background: var(--card);
    border: 1px solid var(--border);
    padding: clamp(1rem, 2vw, 1.5rem);
    display: grid;
    gap: 1.5rem;
    align-content: start;
    box-shadow: var(--shadow);
  }
  .tile-care::after {
    background: radial-gradient(420px circle at var(--mx, -100px) var(--my, -100px), rgb(140 198 63 / 0.12), transparent 45%);
  }
  .care-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(1rem, 3vw, 2rem);
    align-items: center;
  }
  .care-top img {
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 20px;
    width: 100%;
  }
  .care-head {
    display: grid;
    gap: 1rem;
  }
  .care-head h3 {
    font-size: clamp(1.9rem, 3.2vw, 2.75rem);
  }
  .care-head h3 a {
    text-decoration: none;
  }
  .care-head p {
    color: var(--ink-2);
  }
  .freq {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .freq li {
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    background: var(--evergreen);
    color: var(--on-evergreen);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .visits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .visits li {
    background: var(--paper);
    border-radius: 16px;
    padding: 0.9rem 0.9rem 1rem;
    display: grid;
    gap: 0.25rem;
    transition:
      background-color 200ms,
      transform 300ms var(--ease-out);
  }
  .visits li:hover {
    background: var(--season-soft);
    transform: translateY(-3px);
  }
  .v-len {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    line-height: 1;
  }
  .v-team {
    font-size: 0.85rem;
    color: var(--ink-2);
  }
  .tile-link {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 650;
    text-decoration: none;
    border-bottom: 2px solid var(--leaf);
    padding-bottom: 0.15rem;
  }

  .tile-photo {
    display: flex;
    align-items: flex-end;
    min-height: 17rem;
    color: #fff;
    text-decoration: none;
  }
  .tile-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 900ms var(--ease-out);
  }
  .tile-photo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(12 26 17 / 0) 30%, rgb(12 26 17 / 0.82) 100%);
  }
  .tile-photo:hover img {
    transform: scale(1.06);
  }
  .tile-body {
    display: grid;
    gap: 0.35rem;
    padding: 1.4rem 4.5rem 1.4rem 1.4rem;
  }
  .tile-name {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .tile-short {
    font-size: 0.98rem;
    color: rgb(255 255 255 / 0.85);
    max-width: 36ch;
  }
  .tile-go {
    position: absolute;
    right: 1.2rem;
    bottom: 1.2rem;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.16);
    border: 1px solid rgb(255 255 255 / 0.3);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition:
      background-color 300ms,
      color 300ms,
      transform 400ms var(--ease-out);
  }
  .tile-photo:hover .tile-go {
    background: var(--leaf);
    color: var(--ink);
    transform: rotate(-45deg);
  }
  .tile-garden-intervention {
    grid-column: 5 / 7;
  }
  .tile-garden-health {
    grid-column: 5 / 7;
  }
  .tile-pots-and-planters {
    grid-column: 1 / 4;
    min-height: 20rem;
  }
  .tile-also {
    grid-column: 4 / 7;
    background: var(--evergreen);
    color: var(--on-evergreen);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: grid;
    gap: 1.25rem;
    align-content: center;
    justify-items: start;
  }
  .also-title {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    line-height: 1;
  }
  .also-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .also-chips li {
    padding: 0.55rem 1rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.2);
    background: rgb(255 255 255 / 0.06);
    font-weight: 550;
  }

  @media (max-width: 960px) {
    .bento {
      grid-template-columns: 1fr 1fr;
    }
    .tile-care {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .tile-garden-intervention,
    .tile-garden-health {
      grid-column: span 1;
    }
    .tile-pots-and-planters,
    .tile-also {
      grid-column: 1 / -1;
    }
    .visits {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 620px) {
    .section-head,
    .care-top {
      grid-template-columns: 1fr;
    }
    .tile-garden-intervention,
    .tile-garden-health {
      grid-column: 1 / -1;
    }
    .visits {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Stacking steps */
  .steps {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(4rem, 9vw, 7rem);
  }
  .steps-title {
    max-width: 16ch;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .card {
    position: sticky;
    top: calc(6.5rem + var(--i) * 1.75rem);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius-lg);
    min-height: clamp(20rem, 42vw, 28rem);
    box-shadow: 0 -10px 40px -24px rgb(10 25 16 / 0.45);
    transform-origin: 50% 0;
  }
  @supports (animation-timeline: view()) {
    .card {
      animation: settle linear both;
      animation-timeline: view();
      animation-range: exit-crossing 0% exit-crossing 60%;
    }
    @keyframes settle {
      to {
        transform: scale(0.94);
        filter: brightness(0.92);
      }
    }
  }
  .card img {
    width: 100%;
    height: 100%;
    max-height: 24rem;
    object-fit: cover;
    border-radius: 20px;
  }
  .card-copy {
    display: grid;
    gap: 1rem;
    align-content: center;
    padding: clamp(0.5rem, 2vw, 1.5rem);
  }
  .card-num {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.4rem;
    border: 1.5px solid currentColor;
  }
  .card h3 {
    font-size: clamp(2rem, 4.2vw, 3.5rem);
    max-width: 12ch;
  }
  .card p {
    max-width: 40ch;
    font-size: 1.15rem;
  }
  .tone-paper {
    background: var(--card);
    border: 1px solid var(--border);
    color: var(--ink);
  }
  .tone-paper p {
    color: var(--ink-2);
  }
  .tone-evergreen {
    background: var(--evergreen);
    color: var(--on-evergreen);
  }
  .tone-evergreen p {
    color: var(--on-evergreen-2);
  }
  .tone-soft {
    background: #dfe8d3;
    color: var(--ink);
  }
  .tone-soft p {
    color: var(--ink-2);
  }
  @media (max-width: 760px) {
    .card {
      grid-template-columns: 1fr;
      top: calc(5.5rem + var(--i) * 1.25rem);
    }
    .card img {
      max-height: 13rem;
    }
  }

  /* Statement */
  .statement {
    padding-block: clamp(4rem, 10vw, 8rem);
  }
  .statement-text {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(2.2rem, 5.6vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    max-width: 22ch;
  }
  /* Each letter is drawn grey and light, then written over in full ink and bold as the paragraph
     rises. Its box is sized for the bold letter, so nothing shifts as the weight grows. */
  .sw {
    white-space: nowrap;
  }
  .sc {
    display: inline-block;
    font-weight: 780;
    color: var(--ink);
  }
  .sc::after {
    content: attr(data-c);
    display: block;
    height: 0;
    overflow: hidden;
    visibility: hidden;
    font-weight: 780;
  }
