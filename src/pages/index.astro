---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import YearRibbon from '../components/YearRibbon.astro';
import Proof from '../components/Proof.astro';
import CallToAction from '../components/CallToAction.astro';
import { contact, services, alsoOffer, visitOptions, months } from '../data/site';

const [care, intervention, health, pots] = services;
const thisMonth = months[new Date().getMonth()];

const colA = [
  { src: '/img/topiary-tulips.jpg', alt: 'Lollipop topiary above pink tulips at a granite entrance.' },
  { src: '/img/acer-garden.jpg', alt: 'A copper acer framing a lawn and a border of roses.' },
  { src: '/img/striped-lawn-bench.jpg', alt: 'A striped lawn leading to a white bench.' },
  { src: '/img/tulips-paving.jpg', alt: 'Tulips along a granite kerb.' },
];
const colB = [
  { src: '/img/bench-border.jpg', alt: 'A curved lawn with bay trees and a white bench.' },
  { src: '/img/alliums-van.jpg', alt: 'Purple alliums in front of the Darragh Connolly van.' },
  { src: '/img/striped-lawn-bench.jpg', alt: 'A striped lawn leading to a white bench.' },
  { src: '/img/topiary-tulips.jpg', alt: 'Lollipop topiary above pink tulips at a granite entrance.' },
];

const ticker = ['Lawn care', 'Hedging', 'Bulb planting', 'Pots & planters', 'Pruning', 'Mulching', 'Garden health', 'Weeding', 'Border care', 'Power washing'];

const steps = [
  {
    title: 'We visit and listen',
    text: 'Darragh walks the garden with you, talks about how you use it, and looks at what it needs now and through the year.',
    image: '/img/bench-border.jpg',
    tone: 'paper',
  },
  {
    title: 'We plan your schedule',
    text: 'Monthly, fortnightly or weekly visits, from 1.5 hours to a full day, always with a team of two gardeners.',
    image: '/img/striped-lawn-bench.jpg',
    tone: 'evergreen',
  },
  {
    title: 'We keep it right, all year',
    text: 'We bring all the tools, work efficiently and take the green waste away. You get to simply enjoy the garden.',
    image: '/img/acer-garden.jpg',
    tone: 'season',
  },
];

const statement =
  "We don't lay paving, paths or patios. We look after gardens, and that's all we do, so yours gets our full attention every single visit.".split(
    ' ',
  );
---

<Base>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title" data-type data-speed="55">Your garden, looked after all year.</h1>
      <p class="lede hero-lede">
        Darragh Connolly and his team care for gardens across Dublin and North Wicklow: regular maintenance, seasonal
        interventions, lawn health and planted pots.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/contact/">Get a quote <Icon name="arrow" /></a>
        <a class="btn btn-ghost" href={contact.phoneHref}><Icon name="phone" /> {contact.phone}</a>
      </div>
      <a class="now" href="#year-title">
        <span class="now-dot" aria-hidden="true"></span>
        <span><strong>This {thisMonth.name}:</strong> {thisMonth.work[0].toLowerCase()}</span>
        <Icon name="arrow" />
      </a>
    </div>

    <div class="hero-cols" aria-label="Gardens we look after">
      <div class="col">
        <div class="col-track">
          {[...colA, ...colA].map((p, i) => <img src={p.src} alt={i < colA.length ? p.alt : ''} loading={i < 2 ? 'eager' : 'lazy'} />)}
        </div>
      </div>
      <div class="col col-down">
        <div class="col-track">
          {[...colB, ...colB].map((p, i) => <img src={p.src} alt={i < colB.length ? p.alt : ''} loading={i < 2 ? 'eager' : 'lazy'} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- Ticker -->
  <div class="ticker marquee" aria-hidden="true" style="--speed: 50s; --gap: 2.5rem">
    {
      [0, 1].map(() => (
        <div class="marquee-track">
          {ticker.map((t, i) => (
            <span class:list={['tick', { hollow: i % 2 === 1 }]}>
              {t}
              <svg viewBox="0 0 24 24" class="leaf"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14zM5 19l7-7" /></svg>
            </span>
          ))}
        </div>
      ))
    }
  </div>

  <YearRibbon />

  <!-- Services bento -->
  <section class="services" aria-labelledby="services-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="services-title" data-type>How we look after a garden</h2>
        <p class="lede">Garden care is all we do. Start with a visit or a Garden Intervention, then keep it right with regular care.</p>
      </div>

      <div class="bento">
        <article class="tile tile-care" data-pop>
          <div class="care-top">
            <img src={care.image} alt={care.imageAlt} loading="lazy" />
            <div class="care-head">
              <h3><a href={`/services/${care.slug}/`}>{care.name}</a></h3>
              <p>{care.short}</p>
              <ul class="freq">
                <li data-pop style="--d:3">Monthly</li>
                <li data-pop style="--d:4">Fortnightly</li>
                <li data-pop style="--d:5">Weekly</li>
              </ul>
            </div>
          </div>
          <ul class="visits">
            {
              visitOptions.map((v, i) => (
                <li data-pop style={`--d:${i + 2}`}>
                  <span class="v-len">{v.length}</span>
                  <span class="v-team">{v.team}</span>
                </li>
              ))
            }
          </ul>
          <a class="tile-link" href={`/services/${care.slug}/`}>What a visit includes <Icon name="arrow" /></a>
        </article>

        {
          [intervention, health, pots].map((s, i) => (
            <a class:list={['tile', 'tile-photo', `tile-${s.slug}`]} href={`/services/${s.slug}/`} data-pop style={`--d:${i + 1}`}>
              <img src={s.image} alt="" loading="lazy" />
              <span class="tile-body">
                <span class="tile-name">{s.name}</span>
                <span class="tile-short">{s.short}</span>
              </span>
              <span class="tile-go" aria-hidden="true">
                <Icon name="arrow" />
              </span>
            </a>
          ))
        }

        <div class="tile tile-also" data-pop style="--d:2">
          <p class="also-title">Also on the list</p>
          <ul class="also-chips">
            {alsoOffer.map((a, i) => <li data-pop style={`--d:${i + 3}`}>{a}</li>)}
          </ul>
          <a class="btn btn-leaf" href="/services/">All services <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works: stacking cards -->
  <section class="steps" aria-labelledby="steps-title">
    <div class="wrap">
      <h2 id="steps-title" class="steps-title" data-type>Three steps to a garden you don't have to worry about</h2>
      <ol class="stack">
        {
          steps.map((s, i) => (
            <li class:list={['card', `tone-${s.tone}`]} style={`--i:${i}`} data-pop>
              <div class="card-copy">
                <span class="card-num" data-pop style="--d:3">{i + 1}</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
              <img src={s.image} alt="" loading="lazy" />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Statement: words light up on scroll -->
  <section class="statement" aria-label="What we don't do">
    <div class="wrap">
      <p class="statement-text">
        {statement.map((w) => <span class="sw">{w} </span>)}
      </p>
    </div>
  </section>

  <Proof />

  <!-- About -->
  <section class="about" aria-labelledby="about-title">
    <div class="wrap about-grid">
      <figure class="plate about-plate" data-pop>
        <img src="/img/alliums-van.jpg" alt="Purple alliums in front of the Darragh Connolly Garden Care van." loading="lazy" />
      </figure>
      <div class="about-body" data-reveal style="--d:1">
        <h2 id="about-title" data-type>He'll look after your garden like it's his own.</h2>
        <p>
          Darragh's work is mainly in Dublin and North Wicklow. He carries out all work thoroughly, to the highest
          standard possible, and takes pride in doing so. The business has grown through referrals from clients who are
          happy with their gardens.
        </p>
        <a class="btn btn-ghost" href="/about/">About Darragh <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <CallToAction />

  <aside class="toast" role="status" aria-live="polite" hidden>
    <span class="toast-icon" aria-hidden="true"><Icon name="phone" /></span>
    <span class="toast-text"><strong>Planning {thisMonth.season} work?</strong> Darragh is on {contact.phone}</span>
    <a class="toast-go" href={contact.phoneHref}>Call</a>
    <button class="toast-x" type="button" aria-label="Dismiss"><Icon name="close" /></button>
  </aside>
</Base>

<script>
  // A small note that pops up once per visit.
  const toast = document.querySelector<HTMLElement>('.toast');
  if (toast) {
    let seen = false;
    try {
      seen = sessionStorage.getItem('dc-toast') === '1';
    } catch {}
    if (!seen) {
      setTimeout(() => {
        toast.hidden = false;
        requestAnimationFrame(() => toast.classList.add('show'));
      }, 4500);
    }
    toast.querySelector('.toast-x')?.addEventListener('click', () => {
      toast.classList.remove('show');
      setTimeout(() => (toast.hidden = true), 400);
      try {
        sessionStorage.setItem('dc-toast', '1');
      } catch {}
    });
  }

  // Spotlight that follows the pointer across bento tiles.
  document.querySelectorAll<HTMLElement>('.tile').forEach((tile) => {
    tile.addEventListener('pointermove', (e) => {
      const r = tile.getBoundingClientRect();
      tile.style.setProperty('--mx', `${e.clientX - r.left}px`);
      tile.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });

  // Statement: light each word as the paragraph scrolls through the viewport.
  const text = document.querySelector<HTMLElement>('.statement-text');
  if (text) {
    const words = Array.from(text.querySelectorAll<HTMLElement>('.sw'));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = text.getBoundingClientRect();
      const start = innerHeight * 0.85;
      const end = innerHeight * 0.3;
      const p = reduce ? 1 : Math.min(1, Math.max(0, (start - r.top) / (start - end + r.height * 0.6)));
      const lit = Math.round(p * words.length);
      words.forEach((w, i) => w.classList.toggle('lit', i < lit));
    };
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>

<style>
  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    max-width: calc(var(--max) + 4rem);
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 3rem) var(--gutter) clamp(2rem, 4vw, 3rem);
    min-height: min(calc(100svh - 5.75rem), 56rem);
  }
  .hero-copy {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .hero h1 {
    font-size: clamp(3.25rem, 7vw, 6.5rem);
    font-stretch: 75%;
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.03em;
    max-width: 12ch;
  }
  .hero-lede {
    max-width: 34ch;
  }
  .js .hero-lede,
  .js .hero-actions,
  .js .now {
    animation: fade-up 900ms var(--ease-out) both;
  }
  .js .hero-lede {
    animation-delay: 1700ms;
  }
  .js .hero-actions,
  .js .now {
    animation-name: pop-in;
    animation-duration: 800ms;
    animation-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .js .hero-actions {
    animation-delay: 2100ms;
  }
  .js .now {
    animation-delay: 2500ms;
  }
  @keyframes pop-in {
    from {
      opacity: 0;
      transform: scale(0.85) translateY(12px);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
      filter: blur(6px);
    }
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero-actions .btn-ghost {
    font-variant-numeric: tabular-nums;
  }
  .now {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 0.9rem 0.5rem 0.75rem;
    border-radius: 999px;
    background: var(--season-soft);
    color: var(--ink);
    text-decoration: none;
    font-size: 0.95rem;
    transition: background-color 200ms;
  }
  .now strong {
    color: var(--season-ink);
  }
  .now-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--season-ink);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--season-ink) 60%, transparent);
    animation: pulse 2.4s var(--ease-out) infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 10px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  .now :global(svg) {
    transition: transform 220ms var(--ease-out);
  }
  .now:hover :global(svg) {
    transform: translateX(3px);
  }

  .hero-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    height: min(calc(100svh - 9rem), 48rem);
    min-height: 30rem;
    overflow: hidden;
    border-radius: var(--radius-lg);
    -webkit-mask: linear-gradient(transparent, #000 10%, #000 90%, transparent);
    mask: linear-gradient(transparent, #000 10%, #000 90%, transparent);
  }
  .col {
    overflow: hidden;
  }
  .col-track {
    display: grid;
    gap: 1rem;
    animation: col-up 34s linear infinite;
  }
  .col-down .col-track {
    animation-duration: 46s;
    animation-delay: -12s;
  }
  .hero-cols:hover .col-track {
    animation-play-state: paused;
  }
  @keyframes col-up {
    to {
      transform: translateY(calc(-50% - 0.5rem));
    }
  }
  .col img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 20px;
    background: var(--paper-2);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .hero-cols {
      height: 24rem;
      min-height: 0;
    }
  }

  /* Ticker */
  .ticker {
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-block: 1px solid var(--rule);
    margin-bottom: clamp(1rem, 3vw, 2rem);
  }
  .tick {
    display: inline-flex;
    align-items: center;
    gap: 2.5rem;
    white-space: nowrap;
    font-family: var(--display);
    font-stretch: 75%;
    font-weight: 800;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .tick.hollow {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
  }
  .leaf {
    width: 0.6em;
    height: 0.6em;
    fill: var(--leaf);
    stroke: var(--evergreen);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  /* Services bento */
  .services {
    padding-block: clamp(4rem, 9vw, 7.5rem);
  }
  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 1.25rem clamp(2rem, 5vw, 5rem);
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .section-head h2 {
    max-width: 12ch;
  }
  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: minmax(15rem, auto);
    gap: 1rem;
  }
  .tile {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    isolation: isolate;
  }
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(420px circle at var(--mx, -100px) var(--my, -100px), rgb(255 255 255 / 0.16), transparent 45%);
    opacity: 0;
    transition: opacity 300ms;
    pointer-events: none;
    z-index: 2;
  }
  .tile:hover::after {
    opacity: 1;
  }

  .tile-care {
    grid-column: 1 / 5;
    grid-row: span 2;
    background: #fbfbf7;
    padding: clamp(1rem, 2vw, 1.5rem);
    display: grid;
    gap: 1.5rem;
    align-content: start;
    box-shadow: 0 1px 2px rgb(23 37 28 / 0.06), 0 18px 40px -24px rgb(23 37 28 / 0.25);
  }
  .tile-care::after {
    background: radial-gradient(420px circle at var(--mx, -100px) var(--my, -100px), rgb(140 198 63 / 0.12), transparent 45%);
  }
  .care-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(1rem, 3vw, 2rem);
    align-items: center;
  }
  .care-top img {
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 20px;
    width: 100%;
  }
  .care-head {
    display: grid;
    gap: 1rem;
  }
  .care-head h3 {
    font-size: clamp(1.9rem, 3.2vw, 2.75rem);
  }
  .care-head h3 a {
    text-decoration: none;
  }
  .care-head p {
    color: var(--ink-2);
  }
  .freq {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .freq li {
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    background: var(--evergreen);
    color: var(--on-evergreen);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .visits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .visits li {
    background: var(--paper);
    border-radius: 16px;
    padding: 0.9rem 0.9rem 1rem;
    display: grid;
    gap: 0.25rem;
    transition:
      background-color 200ms,
      transform 300ms var(--ease-out);
  }
  .visits li:hover {
    background: var(--season-soft);
    transform: translateY(-3px);
  }
  .v-len {
    font-family: var(--display);
    font-stretch: 78%;
    font-weight: 750;
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    line-height: 1;
  }
  .v-team {
    font-size: 0.85rem;
    color: var(--ink-2);
  }
  .tile-link {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 650;
    text-decoration: none;
    border-bottom: 2px solid var(--leaf);
    padding-bottom: 0.15rem;
  }

  .tile-photo {
    display: flex;
    align-items: flex-end;
    min-height: 17rem;
    color: #fff;
    text-decoration: none;
  }
  .tile-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 900ms var(--ease-out);
  }
  .tile-photo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(12 26 17 / 0) 30%, rgb(12 26 17 / 0.82) 100%);
  }
  .tile-photo:hover img {
    transform: scale(1.06);
  }
  .tile-body {
    display: grid;
    gap: 0.35rem;
    padding: 1.4rem 4.5rem 1.4rem 1.4rem;
  }
  .tile-name {
    font-family: var(--display);
    font-stretch: 78%;
    font-weight: 750;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .tile-short {
    font-size: 0.98rem;
    color: rgb(255 255 255 / 0.85);
    max-width: 36ch;
  }
  .tile-go {
    position: absolute;
    right: 1.2rem;
    bottom: 1.2rem;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.16);
    border: 1px solid rgb(255 255 255 / 0.3);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition:
      background-color 300ms,
      color 300ms,
      transform 400ms var(--ease-out);
  }
  .tile-photo:hover .tile-go {
    background: var(--leaf);
    color: var(--ink);
    transform: rotate(-45deg);
  }
  .tile-garden-intervention {
    grid-column: 5 / 7;
  }
  .tile-garden-health {
    grid-column: 5 / 7;
  }
  .tile-pots-and-planters {
    grid-column: 1 / 4;
    min-height: 20rem;
  }
  .tile-also {
    grid-column: 4 / 7;
    background: var(--evergreen);
    color: var(--on-evergreen);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: grid;
    gap: 1.25rem;
    align-content: center;
    justify-items: start;
  }
  .also-title {
    font-family: var(--display);
    font-stretch: 78%;
    font-weight: 750;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    line-height: 1;
  }
  .also-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .also-chips li {
    padding: 0.55rem 1rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.2);
    background: rgb(255 255 255 / 0.06);
    font-weight: 550;
  }

  @media (max-width: 960px) {
    .bento {
      grid-template-columns: 1fr 1fr;
    }
    .tile-care {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .tile-garden-intervention,
    .tile-garden-health {
      grid-column: span 1;
    }
    .tile-pots-and-planters,
    .tile-also {
