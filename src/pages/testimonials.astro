---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CallToAction from '../components/CallToAction.astro';
import { reviews, contact } from '../data/site';

const [lead, ...rest] = reviews;
const areas = [...new Set(reviews.map((r) => r.place.split(',')[0]))];
const initials = (n: string) => n.split(' ').map((p) => p[0]).join('');
const ticker = reviews.map((r) => r.quote.split(/[.!]/)[0]);
---

<Base
  garden
  title="Testimonials"
  description="What clients across Dublin say about Darragh Connolly Garden Care: reliable, tidy, highest-standard garden care in Dalkey, Blackrock, Foxrock, Monkstown and beyond."
>
  <section class="wrap hero" aria-labelledby="t-title">
    <div class="hero-copy">
      <h1 id="t-title" data-type data-speed="50">In their own words.</h1>
      <p class="lede" data-reveal>
        Darragh's business has grown through referrals. Here's what <span data-count>{reviews.length}</span> clients across Dublin say about the gardens he looks
        after.
      </p>
    </div>
    <div class="hero-stack" aria-hidden="true">
      {
        reviews.slice(0, 4).map((r, i) => (
          <figure class={`stk s${i}`} style={`--i:${i}`}>
            <img src={r.img} alt="" />
          </figure>
        ))
      }
    </div>
  </section>

  <div class="marquee quotes-band" aria-hidden="true" style="--speed: 70s; --gap: 3rem">
    {
      [0, 1].map(() => (
        <div class="marquee-track">
          {ticker.map((t) => (
            <span class="qt">
              “{t}”
              <svg viewBox="0 0 24 24" class="leaf"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14zM5 19l7-7" /></svg>
            </span>
          ))}
        </div>
      ))
    }
  </div>

  <section class="wrap feature" aria-label={`Review from ${lead.name}`}>
    <figure class="feature-card" data-reveal>
      <img src={lead.img} alt="A restored border with lupins and a dry-stone edge beside a lawn." />
      <div class="feature-body">
        <span class="tag">{lead.tag}</span>
        <blockquote><p>{lead.quote}</p></blockquote>
        <figcaption>
          <span class="avatar">{initials(lead.name)}</span>
          <span><strong>{lead.name}</strong><small>{lead.place}</small></span>
        </figcaption>
      </div>
    </figure>
  </section>

  <section class="wrap wall" aria-labelledby="wall-title">
    <h2 id="wall-title" data-type>More from our clients</h2>
    <ul class="masonry" data-stagger="rise">
      {
        rest.map((r, i) => (
          <li class="card" data-pop style={`--d:${i % 3}`}>
            <img src={r.img} alt={`A garden in ${r.place.split(',')[0]} looked after by Darragh Connolly.`} loading="lazy" />
            <div class="card-body">
              <span class="tag">{r.tag}</span>
              <blockquote><p>{r.quote}</p></blockquote>
              <figcaption>
                <span class="avatar">{initials(r.name)}</span>
                <span><strong>{r.name}</strong><small>{r.place}</small></span>
              </figcaption>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap areas" aria-labelledby="areas-title">
    <div class="areas-card" data-reveal>
      <div>
        <h2 id="areas-title">Trusted across Dublin.</h2>
        <p>Reviews from gardens in {areas.length} neighbourhoods, and the business keeps growing through word of mouth.</p>
      </div>
      <ul class="area-chips" data-stagger="scatter">
        {areas.map((a, i) => <li data-pop style={`--d:${i}`}><Icon name="pin" /> {a}</li>)}
      </ul>
    </div>
  </section>

  <CallToAction
    heading="Become our next happy garden."
    text={`Call Darragh on ${contact.phone} or book a free discovery call, and let's talk about what your garden needs.`}
  />
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 2rem clamp(2rem, 5vw, 5rem); align-items: center; padding-block: clamp(2rem, 5vw, 4rem); }
  .hero-copy { display: grid; gap: 1.25rem; justify-items: start; }
  .hero h1 { font-size: clamp(3rem, 7.5vw, 6.5rem); line-height: 0.95; max-width: 9ch; }
  .hero-stack { position: relative; height: clamp(22rem, 36vw, 30rem); }
  .stk { position: absolute; margin: 0; width: 46%; border-radius: 24px; overflow: hidden; border: 6px solid #fff; box-shadow: 0 30px 60px -30px rgb(10 25 16 / 0.55); animation: deal 900ms cubic-bezier(0.2, 1.25, 0.35, 1) both, bob 7s ease-in-out infinite alternate; animation-delay: calc(400ms + var(--i) * 380ms), calc(2.6s + var(--i) * 1.4s); }
  .stk img { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .s0 { left: 0; top: 10%; rotate: -7deg; z-index: 2; }
  .s1 { left: 28%; top: 0; rotate: 3deg; z-index: 4; }
  .s2 { right: 0; top: 18%; rotate: 8deg; z-index: 3; }
  .s3 { left: 20%; bottom: 0; rotate: -2deg; z-index: 1; width: 40%; }
  @keyframes bob { to { translate: 0 -10px; } }

  .quotes-band { padding-block: 1.25rem; border-block: 1px solid var(--border); margin-block: clamp(1rem, 3vw, 2rem); }
  .qt { display: inline-flex; align-items: center; gap: 3rem; white-space: nowrap; font-family: var(--display); font-weight: 500; font-size: clamp(1.4rem, 2.8vw, 2.2rem); letter-spacing: -0.04em; color: var(--ink-2); }
  .leaf { width: 1.1em; height: 1.1em; fill: var(--leaf); stroke: var(--evergreen); stroke-width: 1.4; stroke-linejoin: round; }

  .feature { padding-block: clamp(2rem, 5vw, 4rem); }
  .feature-card { margin: 0; display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); background: var(--evergreen); color: var(--on-evergreen); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow); }
  .feature-card > img { width: 100%; height: 100%; min-height: 24rem; object-fit: cover; }
  .feature-body { padding: clamp(1.75rem, 4vw, 3.5rem); display: grid; gap: 1.5rem; align-content: center; justify-items: start; }
  .feature blockquote { margin: 0; }
  .feature blockquote p { font-family: var(--display); font-weight: 500; font-size: clamp(1.4rem, 2.5vw, 2rem); line-height: 1.25; letter-spacing: -0.035em; }
  .feature blockquote p::before { content: '“'; color: var(--leaf); }
  .feature blockquote p::after { content: '”'; color: var(--leaf); }
  .feature .tag { background: var(--leaf); color: var(--evergreen); }
  .feature small { color: var(--on-evergreen-2) !important; }

  .tag { font-size: 0.8rem; font-weight: 650; padding: 0.3rem 0.75rem; border-radius: 999px; background: #dfe8d3; color: var(--leaf-ink); }
  figcaption { display: flex; align-items: center; gap: 0.75rem; }
  figcaption strong { display: block; }
  figcaption small { display: block; color: var(--ink-2); font-size: 0.9rem; }
  .avatar { flex: none; width: 2.75rem; height: 2.75rem; border-radius: 50%; display: grid; place-items: center; background: var(--leaf); color: var(--evergreen); font-weight: 700; }

  .wall { padding-block: clamp(2rem, 5vw, 4rem); }
  .wall h2 { margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .masonry { list-style: none; margin: 0; padding: 0; columns: 3 19rem; column-gap: 1rem; }
  .card { break-inside: avoid; margin-bottom: 1rem; background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow); transition: transform 400ms var(--ease-out); }
  .card:hover { transform: translateY(-6px); }
  .card img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .card:nth-child(3n + 2) img { aspect-ratio: 1; }
  .card-body { padding: 1.4rem; display: grid; gap: 1rem; justify-items: start; }
  .card blockquote { margin: 0; }
  .card blockquote p { color: var(--ink-2); font-size: 1.02rem; line-height: 1.55; }
  .card blockquote p::before { content: '“'; font-family: var(--display); font-weight: 600; font-size: 2.6rem; line-height: 0.2; vertical-align: -0.45em; margin-right: 0.15rem; color: var(--leaf-ink); }

  .areas { padding-block: clamp(2rem, 5vw, 4rem) 0; }
  .areas-card { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 2rem clamp(2rem, 5vw, 5rem); align-items: center; background: #dfe8d3; border-radius: var(--radius-lg); padding: clamp(1.75rem, 4vw, 3.5rem); }
  .areas-card h2 { font-size: clamp(2rem, 4vw, 3.25rem); margin-bottom: 0.75rem; }
  .areas-card p { color: var(--ink-2); font-size: 1.1rem; }
  .area-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .area-chips li { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.65rem 1.1rem; border-radius: 999px; background: var(--card); font-weight: 600; box-shadow: var(--shadow); }
  .area-chips :global(svg) { color: var(--leaf-ink); }

  @media (max-width: 860px) {
    .hero, .feature-card, .areas-card { grid-template-columns: 1fr; }
    .feature-card > img { min-height: 16rem; }
  }
  @media (prefers-reduced-motion: reduce) { .stk { animation: none; } }
</style>
