---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Proof from '../components/Proof.astro';
import CallToAction from '../components/CallToAction.astro';
import { contact } from '../data/site';
---

<Base title="About Darragh" description="Darragh Connolly looks after gardens across Dublin and North Wicklow, to the highest standard, and builds his business on referrals.">
  <PageHead title="About Darragh" lede="Garden care, done thoroughly, by someone who takes pride in it." />

  <div class="wrap about">
    <figure class="plate">
      <img src="/img/acer-garden.jpg" alt="A copper acer framing a lawn and a border of pink roses." />
    </figure>
    <div class="about-text">
      <p class="big">
        Darragh's work is mainly in Dublin and North Wicklow. He regards himself as a person who carries out all work
        thoroughly, to the highest standard possible, and takes pride in doing so.
      </p>
      <p>
        He builds his business through client referral and satisfaction. He is purely focused on garden care and will
        look after your garden like it's his own.
      </p>
      <p>
        A garden should be more than a collection of plants. It should be a place of peace, renewal and connection with
        nature. Whether you need a full intervention, a health check for the lawn and soil, or regular maintenance, we
        help you create and keep a garden that adds to your well-being, not just your view.
      </p>
      <h2>Why clients choose us</h2>
      <ul class="ticks">
        <li><span><strong>Tailored to your lifestyle.</strong> Spaces that feel good and are easy to maintain.</span></li>
        <li><span><strong>A natural approach.</strong> We work with nature, not against it.</span></li>
        <li><span><strong>Well-being at the centre.</strong> Every choice supports relaxation and calm.</span></li>
      </ul>
      <p class="area">We work across {contact.area}.</p>
    </div>
  </div>

  <Proof />
  <CallToAction />
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: clamp(3rem, 7vw, 6rem);
    align-items: start;
  }
  .about img {
    aspect-ratio: 1;
    object-fit: cover;
  }
  .about-text {
    display: grid;
    gap: 1.25rem;
  }
  .about-text p {
    max-width: 58ch;
    color: var(--ink-2);
  }
  .about-text .big {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    line-height: 1.2;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .about-text h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    margin-top: 1.5rem;
  }
  .area {
    font-weight: 600;
  }
  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
